diff --git a/code/tests/correction_invariant_witness.cpp b/code/tests/correction_invariant_witness.cpp
new file mode 100644
index 0000000..e8546b7
--- /dev/null
+++ b/code/tests/correction_invariant_witness.cpp
@@ -0,0 +1,140 @@
+#include <goc/goc.h>
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+
+#include "labeling/monodirectional_labeling.h"
+#include "labeling/bidirectional_labeling.h"
+
+using namespace goc;
+using namespace networks2019;
+
+namespace networks2019 {
+struct CorrectionInvariantWitness {
+	static int Correct(MonodirectionalLabeling& solver, Label* label) {
+		return solver.CorrectionStep(label);
+	}
+	static bool Dominated(MonodirectionalLabeling& solver, Label* label) {
+		return solver.DominationStep(label);
+	}
+	static void Clean(MonodirectionalLabeling& solver) { solver.Clean(); }
+	static bool Owns(MonodirectionalLabeling& solver, Label* label) {
+		for (const auto& vertex : solver.U)
+			for (const auto& demand : vertex)
+				if (std::find(demand.second.begin(), demand.second.end(), label) != demand.second.end()) return true;
+		return false;
+	}
+	static std::size_t MergePool(BidirectionalLabeling& solver, Label* label,
+		const MonodirectionalLabeling::DominanceStructure& pool) {
+		solver.pp_.P = std::vector<double>(5, 0.0);
+		solver.S.clear();
+		solver.IterativeMerge(label, pool);
+		return solver.S.size();
+	}
+};
+}
+
+void require(bool condition, const char* message) {
+	if (!condition) throw std::runtime_error(message);
+}
+
+VRPInstance instance() {
+	VRPInstance vrp;
+	vrp.D = Digraph(5);
+	vrp.o = 0;
+	vrp.d = 4;
+	vrp.T = 10;
+	vrp.Q = 100;
+	vrp.q = std::vector<double>(5, 0.0);
+	vrp.tw = std::vector<Interval>(5, {0.0, 10.0});
+	vrp.tau = Matrix<PWLFunction>(5, 5);
+	vrp.pretau = Matrix<PWLFunction>(5, 5);
+	vrp.arr = Matrix<PWLFunction>(5, 5);
+	vrp.dep = Matrix<PWLFunction>(5, 5);
+	vrp.LDT = Matrix<double>(5, 5);
+	vrp.tau[0][0] = PWLFunction::ConstantFunction(0.0, {0.0, 10.0});
+	return vrp;
+}
+
+void initialize(Label& label, PWLFunction duration, VertexSet unreachable) {
+	label.parent = nullptr;
+	label.v = 1;
+	label.q = 1;
+	label.p = label.cut_cost = 0;
+	label.duration = duration;
+	label.rw = duration.Domain();
+	label.min_cost = std::min(img(duration));
+	label.U = unreachable;
+}
+
+int main() {
+	MonodirectionalLabeling solver(instance());
+	solver.correcting = true;
+	VertexSet a, b;
+	a.set(1).set(2).set(4);
+	b.set(1).set(3).set(4);
+	auto* first = new Label;
+	auto* second = new Label;
+	PWLFunction rising;
+	rising.AddPiece(LinearFunction({0.0, 0.0}, {10.0, 5.0}));
+	initialize(*first, rising, a);
+	initialize(*second, PWLFunction::ConstantFunction(0.5, {0.0, 10.0}), b);
+	auto& bucket = solver.U[1].Insert(1, {});
+	bucket = {first, second};
+	Label arriving;
+	initialize(arriving, PWLFunction::ConstantFunction(0.0, {0.0, 1.0}), a);
+	require(CorrectionInvariantWitness::Correct(solver, &arriving) == 0, "Expected partial correction only");
+	require(first->min_cost > second->min_cost, "Expected stale min-cost order witness");
+	Label query;
+	initialize(query, PWLFunction::ConstantFunction(0.75, {0.0, 10.0}), b);
+	const bool stale_result = CorrectionInvariantWitness::Dominated(solver, &query);
+	std::sort(bucket.begin(), bucket.end(), [](Label* x, Label* y) { return x->min_cost < y->min_cost; });
+	initialize(query, PWLFunction::ConstantFunction(0.75, {0.0, 10.0}), b);
+	const bool sorted_result = CorrectionInvariantWitness::Dominated(solver, &query);
+	require(!stale_result && sorted_result, "Expected sorted early break to hide the valid dominator");
+	std::cout << "stale-order witness: false negative dominance, costs "
+		<< first->min_cost << ", " << second->min_cost << "\n";
+
+	// Exercise the actual iterative-merge early break with the same stale order.
+	// These are synthetic label states, not a full-instance false-closure claim.
+	Label null_forward, start, forward, null_backward, end, middle_first, middle_second;
+	null_forward.parent = null_backward.parent = nullptr;
+	start.parent = &null_forward;
+	start.v = 0;
+	start.cut_cost = 0;
+	initialize(forward, PWLFunction::ConstantFunction(0.0, {0.0, 10.0}), {});
+	forward.parent = &start;
+	forward.p = 0.75;
+	forward.min_cost = -0.75;
+	forward.S.set(0).set(1);
+	end.parent = &null_backward;
+	end.v = 4;
+	middle_first.parent = middle_second.parent = &end;
+	middle_first.v = 2;
+	middle_second.v = 3;
+	first->parent = &middle_first;
+	second->parent = &middle_second;
+	first->S = a;
+	second->S = b;
+	MonodirectionalLabeling::DominanceStructure merge_pool(5);
+	merge_pool[1].Insert(1, {}) = {first, second};
+	BidirectionalLabeling bidirectional(instance());
+	const auto stale_pool = CorrectionInvariantWitness::MergePool(bidirectional, &forward, merge_pool);
+	merge_pool[1].Insert(1, {}) = {second, first};
+	const auto sorted_pool = CorrectionInvariantWitness::MergePool(bidirectional, &forward, merge_pool);
+	require(stale_pool == 0 && sorted_pool == 1, "Expected stale merge order to suppress a negative-cost route");
+	std::cout << "merge witness: stale pool 0 routes, sorted pool 1 negative-cost route\n";
+	CorrectionInvariantWitness::Clean(solver);
+
+	auto* retired = new Label;
+	initialize(*retired, PWLFunction::ConstantFunction(1.0, {0.0, 10.0}), a);
+	solver.U[1].Insert(1, {}).push_back(retired);
+	initialize(arriving, PWLFunction::ConstantFunction(0.0, {0.0, 10.0}), a);
+	require(CorrectionInvariantWitness::Correct(solver, &arriving) == 1, "Expected full correction");
+	require(!CorrectionInvariantWitness::Owns(solver, retired), "Expected corrected-away label to leave the ownership container");
+	// CorrectionStep does not delete the pointer, since lazy children retain it.
+	// Clean deletes only U pointers, so this removed pointer requires manual cleanup.
+	delete retired;
+	CorrectionInvariantWitness::Clean(solver);
+	std::cout << "ownership witness: fully corrected label escapes Clean\n";
+}
