+++ b/tests/cpp/test_u_filter_opportunity_labeling.cpp
@@ -0,0 +1,184 @@
+// Synthetic native calls only. No routing benchmark or master LP is launched.
+#define main correction_base_fixture_main
+#include "test_label_correction.cpp"
+#undef main
+#include <bit>
+#include <cstdint>
+#include <filesystem>
+
+namespace solver {
+struct DominanceProfileTest {
+    static DominanceProfile& Profile(BidirectionalLabeling& solver) { return solver.dominance_profile_; }
+    static void Begin(BidirectionalLabeling& solver) {
+        Profile(solver).Begin({{"fixture", "u_filter_opportunity_native"}});
+        for (int d : {0, 1}) solver.lbl_[d].dominance_profile_ = Profile(solver).GetDirection(d);
+    }
+};
+}
+namespace {
+uint64_t digest = 1469598103934665603ULL;
+void record(double value) { digest ^= std::bit_cast<uint64_t>(value); digest *= 1099511628211ULL; }
+void record(const Label& label) {
+    record(label.v); record(label.q); record(label.p); record(label.cut_cost); record(label.min_cost);
+    record(label.rw.left); record(label.rw.right); record(label.duration.PieceCount());
+    for (size_t i = 0; i < label.U.size(); ++i) record(label.U.test(i));
+    for (const auto& piece : label.duration.Pieces()) {
+        record(piece.domain.left); record(piece.domain.right); record(piece.image.left); record(piece.image.right);
+        record(piece.slope); record(piece.intercept);
+    }
+}
+#ifdef KAYROS_U_FILTER_OPPORTUNITY_PROFILING
+const UFilterOpportunityTotals& totals(BidirectionalLabeling& bidi, DominanceProfile::Kind kind, bool eliminated) {
+    return DominanceProfileTest::Profile(bidi).GetDirection(0)->operations[static_cast<size_t>(kind)].outcomes[eliminated].opportunity;
+}
+void invariants(const UFilterOpportunityTotals& u) {
+    require(u.membership_violations == 0, "Native snapshot membership changed");
+    for (const auto& scale : u.scales) {
+        require(scale.certificate_violations == 0, "Native mask rejected an actual subset pass");
+        require(scale.subset_pass + scale.subset_reject == scale.actual_u_tests, "Native subset counts do not partition");
+        require(scale.covered_actual_rejects <= scale.subset_reject, "Native coverage exceeds actual rejects");
+    }
+}
+#endif
+
+void ordinary(const std::filesystem::path& root, int scenario) {
+    const auto path = root / ("ordinary-" + std::to_string(scenario) + ".jsonl");
+    setenv("KAYROS_DOMINANCE_PROFILE", path.c_str(), 1);
+    setenv("KAYROS_DOMINANCE_PROFILE_STRIDE", "2", 1);
+    setenv("KAYROS_DOMINANCE_PROFILE_OFFSET", scenario == 5 ? "1" : "0", 1);
+    const std::optional<TDNGRoutesParams> ng = std::nullopt;
+    BidirectionalLabeling bidi(instance(), ng);
+    auto& mono = CorrectionInvariantTest::Mono(bidi);
+    mono.sort_by_cost = mono.partial = true;
+    mono.elementary_check_relaxation = scenario == 3;
+    mono.cost_check_relaxation = scenario == 3;
+    DominanceProfileTest::Begin(bidi);
+    VertexSet outside; outside.set(2);
+    std::vector<Label*> originals;
+    for (int i = 0; i < 17; ++i) {
+        auto* label = new Label;
+        initialize(*label, PWLFunction::ConstantFunction(scenario == 2 || (scenario == 0 && i > 0) ? 2.0 : 0.0,
+                                                        {0.0, 10.0}), scenario == 1 && i == 0 ? VertexSet{} : outside);
+        originals.push_back(label);
+    }
+    mono.U[1].Insert(0, {});
+    mono.U[1].Insert(1, {}) = originals;
+    mono.U[1].Insert(2, {});
+    Label query;
+    initialize(query, PWLFunction::ConstantFunction(1.0, {0.0, 10.0}), {});
+    if (scenario == 4) { query.v = 4; query.min_cost = 0.0; }
+    const bool eliminated = CorrectionInvariantTest::Dominated(mono, &query);
+    require(eliminated == (scenario == 1 || scenario == 3 || scenario == 4), "Native ordinary result changed");
+#ifdef KAYROS_U_FILTER_OPPORTUNITY_PROFILING
+    const auto& u = totals(bidi, DominanceProfile::Kind::Dominance, eliminated);
+    invariants(u);
+    if (scenario == 5) {
+        require(u.sampled_calls == 0 && u.snapshot_label_reads == 0, "Unsampled native episode built masks");
+    } else {
+        require(u.sampled_calls == 1, "Native sampled call count changed");
+        if (scenario == 0 || scenario == 2) {
+            require(u.bucket_entries == 3 && u.demand_break_buckets == 1 && u.bucket_snapshots == 2 &&
+                    u.empty_bucket_snapshots == 1 && u.snapshot_label_reads == 17 && u.cost_break_snapshots == 1,
+                    "Native empty/demand/cost buckets changed");
+            for (const auto& scale : u.scales) {
+                const uint64_t count = scenario == 0 ? 1 : 0;
+                require(scale.actual_u_tests == count && scale.covered_actual_rejects == count &&
+                        scale.cost_break_entries == 1, "Native cost break inflated actual rejection coverage");
+            }
+        } else if (scenario == 1) {
+            require(u.early_elimination_snapshots == 1 && u.unvisited_snapshot_members == 16,
+                    "Native early elimination lost the suffix");
+            require(u.scales[1].snapshot_groups == 2 && u.scales[1].loop_reached_groups == 1,
+                    "Native early elimination credited an unvisited block");
+            for (const auto& scale : u.scales) require(scale.covered_actual_rejects == 0 && scale.actual_u_tests == 1,
+                                                      "Native early dominator inflated coverage");
+        } else if (scenario == 3) {
+            require(u.u_relaxed_calls == 1 && u.u_relaxed_buckets == 2 && u.bucket_snapshots == 0,
+                    "Relaxed U mode built masks");
+        } else if (scenario == 4) {
+            require(u.depot_shortcut_calls == 1 && u.bucket_entries == 0 && u.bucket_snapshots == 0,
+                    "Depot shortcut built masks");
+        }
+    }
+#endif
+    record(eliminated); record(query);
+    for (auto* label : originals) record(*label);
+    DominanceProfileTest::Profile(bidi).End({{"status", "Finished"}}, 0, 0);
+    CorrectionInvariantTest::Clean(bidi);
+}
+
+void correction(const std::filesystem::path& root, int scenario) {
+    const auto path = root / ("correction-" + std::to_string(scenario) + ".jsonl");
+    setenv("KAYROS_DOMINANCE_PROFILE", path.c_str(), 1);
+    setenv("KAYROS_DOMINANCE_PROFILE_STRIDE", "1", 1);
+    setenv("KAYROS_DOMINANCE_PROFILE_OFFSET", "0", 1);
+    const std::optional<TDNGRoutesParams> ng = std::nullopt;
+    BidirectionalLabeling bidi(instance(), ng);
+    auto& mono = CorrectionInvariantTest::Mono(bidi);
+    mono.sort_by_cost = mono.partial = true;
+    mono.cost_check_relaxation = scenario == 2;
+    mono.elementary_check_relaxation = scenario == 3;
+    DominanceProfileTest::Begin(bidi);
+    VertexSet arriving_set; arriving_set.set(2);
+    std::vector<Label*> originals;
+    for (int i = 0; i < 33; ++i) {
+        auto* label = new Label;
+        initialize(*label, PWLFunction::ConstantFunction(1.0, {0.0, 10.0}),
+                   i == (scenario == 0 ? 0 : 8) ? arriving_set : VertexSet{});
+        originals.push_back(label);
+    }
+    mono.U[1].Insert(2, {});
+    mono.U[1].Insert(1, {}) = originals;
+    mono.U[1].Insert(0, {});
+    Label arriving;
+    initialize(arriving, PWLFunction::ConstantFunction(0.0, {0.0, 10.0}), arriving_set);
+    const int removed = CorrectionInvariantTest::Correct(mono, &arriving);
+    require(removed == (scenario == 2 ? 0 : scenario == 3 ? 33 : 1), "Native correction result changed");
+#ifdef KAYROS_U_FILTER_OPPORTUNITY_PROFILING
+    const auto& u = totals(bidi, DominanceProfile::Kind::Correction, removed != 0);
+    invariants(u);
+    require(u.sampled_calls == 1, "Native correction sample count changed");
+    if (scenario < 2) {
+        require(u.snapshot_label_reads == 33 && u.retired_labels == 1 && u.membership_violations == 0 &&
+                u.unvisited_snapshot_members == 0 && u.empty_bucket_snapshots == 1 && u.demand_break_buckets == 1,
+                "Correction erasure disrupted its entry snapshot");
+        require(u.scales[0].covered_actual_rejects == 0 && u.scales[1].covered_actual_rejects == 17 &&
+                u.scales[2].covered_actual_rejects == 1 && u.scales[3].covered_actual_rejects == 0,
+                "Correction regrouped after erasure or rebuilt its stale OR");
+        for (const auto& scale : u.scales) require(scale.actual_u_tests == 33 && scale.subset_reject == 32 && scale.subset_pass == 1,
+                                                  "Correction lost an actual subset test");
+    } else if (scenario == 2) {
+        require(u.cost_relaxed_correction_calls == 1 && u.bucket_entries == 0 && u.bucket_snapshots == 0,
+                "HC correction shortcut built masks");
+    } else {
+        require(u.u_relaxed_calls == 1 && u.u_relaxed_buckets == 2 && u.bucket_snapshots == 0,
+                "U-relaxed correction built masks");
+    }
+#endif
+    record(removed); record(arriving);
+    for (auto* label : originals) record(*label);
+    DominanceProfileTest::Profile(bidi).End({{"status", "Finished"}}, 0, 0);
+    CorrectionInvariantTest::Clean(bidi);
+}
+}
+int main() {
+    unsetenv("KAYROS_DOMINANCE_PROFILE");
+    if (correction_base_fixture_main()) return 1;
+    char pattern[] = "/tmp/u-filter-native-XXXXXX";
+    const auto* directory = mkdtemp(pattern);
+    if (!directory) return 2;
+    const std::filesystem::path root(directory);
+    try {
+        for (bool exact : {false, true}) {
+            StepExactArithmeticScope scope(exact);
+            const auto sub = root / (exact ? "exact" : "legacy");
+            std::filesystem::create_directory(sub);
+            for (int scenario = 0; scenario < 6; ++scenario) ordinary(sub, scenario);
+            for (int scenario = 0; scenario < 4; ++scenario) correction(sub, scenario);
+        }
+        unsetenv("KAYROS_DOMINANCE_PROFILE");
+        std::filesystem::remove_all(root);
+        std::cout << "PASS native U-filter scenarios=20 state_digest=" << std::hex << digest << '\n';
+        return 0;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
