@@ -0,0 +1,192 @@
+#include "labeling/u_filter_opportunity.h"
+#include "labeling/dominance_profile.h"
+
+#include <bitset>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+
+using namespace solver;
+namespace {
+struct FakeLabel { std::bitset<8> U; };
+using Mask = decltype(FakeLabel::U);
+using Snapshot = UFilterBucketSnapshot<FakeLabel>;
+void require(bool value, const char* message) { if (!value) throw std::runtime_error(message); }
+bool subset(Mask left, Mask right) { return (left & right) == left; }
+void invariants(const UFilterOpportunityTotals& totals) {
+    require(totals.membership_violations == 0, "Snapshot pointer membership changed");
+    for (const auto& scale : totals.scales) {
+        require(scale.certificate_violations == 0, "A rejected mask admitted an actual subset pass");
+        require(scale.subset_pass + scale.subset_reject == scale.actual_u_tests, "Subset denominator is incomplete");
+        require(scale.covered_actual_rejects <= scale.subset_reject, "Coverage exceeded actual rejects");
+    }
+}
+
+void check_full_masks_and_tails() {
+    std::vector<FakeLabel> owned(65, FakeLabel{Mask(1)});
+    owned.back().U = Mask(2);
+    std::vector<FakeLabel*> labels;
+    for (auto& label : owned) labels.push_back(&label);
+    UFilterOpportunityTotals totals;
+    Snapshot snapshot(&totals, labels, Mask{}, false);
+    for (int i = 0; i < 3; ++i) {
+        snapshot.Visit(labels[i]);
+        snapshot.SubsetRejected(!subset(labels[i]->U, Mask{}));
+    }
+    snapshot.Finish();
+    require(totals.snapshot_label_reads == 65 && totals.unvisited_snapshot_members == 62,
+            "Construction failed to include the unvisited suffix");
+    require(totals.scales[0].mask_rejected_groups == 0 && totals.scales[0].covered_actual_rejects == 0,
+            "Whole mask used only the visited prefix");
+    const uint64_t groups[] = {1, 5, 3, 2};
+    for (size_t i = 0; i < totals.scales.size(); ++i) {
+        require(totals.scales[i].snapshot_groups == groups[i] && totals.scales[i].snapshot_members == 65,
+                "Tail membership changed");
+        require(totals.scales[i].loop_reached_groups == 1 && totals.scales[i].u_test_reached_groups == 1,
+                "Unvisited groups received reach credit");
+        if (i) require(totals.scales[i].covered_actual_rejects == 3, "Coverage credited unvisited members");
+    }
+    invariants(totals);
+}
+
+void check_cost_break_and_early_exit() {
+    std::vector<FakeLabel> owned(17, FakeLabel{Mask(1)});
+    std::vector<FakeLabel*> labels;
+    for (auto& label : owned) labels.push_back(&label);
+    UFilterOpportunityTotals totals;
+    Snapshot snapshot(&totals, labels, Mask{}, false);
+    snapshot.Visit(labels[0]);
+    require(!snapshot.CostBreak(false), "Cost wrapper changed false");
+    snapshot.SubsetRejected(true);
+    snapshot.Visit(labels[1]);
+    require(snapshot.CostBreak(true), "Cost wrapper changed true");
+    snapshot.Finish();
+    for (const auto& scale : totals.scales) {
+        require(scale.loop_entries == 2 && scale.cost_break_entries == 1 && scale.actual_u_tests == 1,
+                "Cost-break label received an actual U test");
+        require(scale.covered_actual_rejects == 1, "Cost break or suffix inflated coverage");
+    }
+    invariants(totals);
+    // A group reached only by a cost break contributes no useful U coverage.
+    UFilterOpportunityTotals cost_only;
+    Snapshot first_break(&cost_only, labels, Mask{}, false);
+    first_break.Visit(labels[0]); first_break.CostBreak(true); first_break.Finish();
+    for (const auto& scale : cost_only.scales)
+        require(scale.loop_reached_groups == 1 && scale.u_test_reached_groups == 0 && scale.covered_actual_rejects == 0,
+                "Cost-only group inflated opportunities");
+    invariants(cost_only);
+    // Early dominator at entry leaves the later rejected block unvisited.
+    owned[0].U = Mask{};
+    UFilterOpportunityTotals early;
+    Snapshot dominator(&early, labels, Mask{}, false);
+    dominator.Visit(labels[0]); dominator.SubsetRejected(false); dominator.Finish(true);
+    require(early.early_elimination_snapshots == 1 && early.unvisited_snapshot_members == 16,
+            "Early elimination lost its unvisited suffix");
+    for (const auto& scale : early.scales) require(scale.covered_actual_rejects == 0, "Early return credited later groups");
+    invariants(early);
+}
+
+void check_correction_erasure_membership() {
+    for (size_t erase_at : {size_t(0), size_t(8)}) {
+        std::vector<FakeLabel> owned(33, FakeLabel{Mask{}});
+        // A passing member in the first block weakens its OR certificate.
+        owned[erase_at].U = Mask(1);
+        std::vector<FakeLabel*> labels;
+        for (auto& label : owned) labels.push_back(&label);
+        UFilterOpportunityTotals totals;
+        Snapshot snapshot(&totals, labels, Mask(1), true);
+        for (size_t j = 0; j < labels.size();) {
+            auto* label = labels[j];
+            snapshot.Visit(label);
+            const bool reject = !subset(Mask(1), label->U);
+            snapshot.SubsetRejected(reject);
+            if (!reject) { snapshot.Retire(); labels.erase(labels.begin() + j); }
+            else ++j;
+        }
+        snapshot.Finish();
+        require(totals.retired_labels == 1 && totals.unvisited_snapshot_members == 0 && totals.snapshot_label_reads == 33,
+                "Erasure changed original snapshot traversal");
+        require(totals.scales[0].covered_actual_rejects == 0, "Whole OR was rebuilt after a retirement");
+        require(totals.scales[1].covered_actual_rejects == 17 && totals.scales[2].covered_actual_rejects == 1 &&
+                totals.scales[3].covered_actual_rejects == 0,
+                "Correction regrouped at a shrinking vector index");
+        invariants(totals);
+    }
+}
+
+void check_empty_inactive_and_violations() {
+    UFilterOpportunityTotals totals;
+    std::vector<FakeLabel*> empty;
+    Snapshot snapshot(&totals, empty, Mask(1), true); snapshot.Finish();
+    require(totals.empty_bucket_snapshots == 1 && totals.finished_snapshots == 1, "Empty bucket lost explicit accounting");
+    for (const auto& scale : totals.scales) require(scale.snapshot_groups == 0, "Empty group received a vacuous certificate");
+    FakeLabel label{Mask(1)}, wrong{Mask(1)};
+    std::vector<FakeLabel*> labels{&label};
+    Snapshot inactive(nullptr, labels, Mask{}, false);
+    inactive.Visit(&wrong); inactive.SubsetRejected(false); inactive.Retire(); inactive.Finish();
+    require(totals.snapshot_label_reads == 0, "Inactive snapshot performed work");
+    UFilterOpportunityTotals wrong_members;
+    Snapshot mismatched(&wrong_members, labels, Mask{}, false);
+    mismatched.Visit(&wrong); mismatched.SubsetRejected(true); mismatched.Finish();
+    require(wrong_members.membership_violations == 1 && wrong_members.scales[0].covered_actual_rejects == 0,
+            "Membership violation was hidden or credited");
+    UFilterOpportunityTotals wrong_certificate;
+    Snapshot impossible(&wrong_certificate, labels, Mask{}, false);
+    impossible.Visit(&label); impossible.SubsetRejected(false); impossible.Finish();
+    for (const auto& scale : wrong_certificate.scales)
+        require(scale.certificate_violations == 1 && scale.covered_actual_rejects == 0,
+                "Certificate violation was hidden or credited");
+}
+
+void check_sampling_reset_and_outcomes() {
+    char pattern[] = "/tmp/u-filter-profile-XXXXXX";
+    const char* directory = mkdtemp(pattern);
+    if (!directory) throw std::runtime_error("Cannot create fixture directory");
+    const std::filesystem::path root(directory), path = root / "profile.jsonl";
+    setenv("KAYROS_DOMINANCE_PROFILE", path.c_str(), 1);
+    setenv("KAYROS_DOMINANCE_PROFILE_STRIDE", "2", 1);
+    setenv("KAYROS_DOMINANCE_PROFILE_OFFSET", "0", 1);
+    {
+        DominanceProfile profile;
+        profile.Begin({});
+        for (int i = 0; i < 3; ++i) {
+            DominanceProfile::Episode episode(profile.GetDirection(0), DominanceProfile::Kind::Dominance);
+            require((episode.Opportunity() != nullptr) == (i % 2 == 0), "Opportunity sampled an unsampled episode");
+            if (auto* totals = episode.Opportunity()) {
+                ++totals->bucket_entries;
+                require(UFilterDemandBreak(totals, true), "Demand-break wrapper changed true");
+            }
+            episode.Finish(i != 0);
+        }
+        profile.End({{"status", "Finished"}}, 0, 0);
+        profile.Begin({});
+        DominanceProfile::Episode reset(profile.GetDirection(0), DominanceProfile::Kind::Dominance);
+        require(reset.Opportunity(), "Sample phase did not reset");
+        reset.Finish(false);
+        profile.End({{"status", "TimeLimitReached"}}, 0, 0);
+    }
+    std::ifstream input(path);
+    std::vector<nlohmann::json> records;
+    std::string line;
+    while (std::getline(input, line)) records.push_back(nlohmann::json::parse(line));
+    require(records.size() == 5 && records[0]["schema"] == "kayros-ms58-u-filter-opportunity-v1", "Feature identity changed");
+    for (const char* outcome : {"survived", "eliminated"}) {
+        const auto& totals = records[2]["forward"]["dominance"][outcome]["sampled_u_filter_opportunity"];
+        require(totals["sampled_calls"] == 1 && totals["demand_break_buckets"] == 1,
+                "Sample-only outcome counters changed");
+    }
+    const auto& reset = records[4]["forward"]["dominance"]["survived"]["sampled_u_filter_opportunity"];
+    require(reset["sampled_calls"] == 1 && reset["bucket_entries"] == 0, "Pricing reset retained opportunity state");
+    unsetenv("KAYROS_DOMINANCE_PROFILE");
+    std::filesystem::remove_all(root);
+}
+}
+int main() {
+    try {
+        check_full_masks_and_tails(); check_cost_break_and_early_exit(); check_correction_erasure_membership();
+        check_empty_inactive_and_violations(); check_sampling_reset_and_outcomes();
+        std::cout << "PASS full-snapshot masks tails actual-U-test-credit cost-break early-elimination erasure membership certificates sample-only reset outcomes\n";
+        return 0;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
