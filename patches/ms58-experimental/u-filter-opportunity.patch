diff --git a/cpp/lera/main/include/labeling/u_filter_opportunity.h b/cpp/lera/main/include/labeling/u_filter_opportunity.h
new file mode 100644
index 0000000..d09ff4a
--- /dev/null
+++ b/cpp/lera/main/include/labeling/u_filter_opportunity.h
@@ -0,0 +1,182 @@
+#pragma once
+
+#ifdef KAYROS_U_FILTER_OPPORTUNITY_PROFILING
+#include <array>
+#include <cstdint>
+#include <utility>
+#include <vector>
+#include "goc/lib/json.hpp"
+
+namespace solver {
+// All counts describe sampled, original execution. Granularities overlap.
+struct UFilterScaleTotals {
+    uint64_t snapshot_groups = 0, snapshot_members = 0;
+    uint64_t mask_rejected_groups = 0, mask_rejected_snapshot_members = 0;
+    uint64_t loop_reached_groups = 0, u_test_reached_groups = 0;
+    uint64_t loop_entries = 0, cost_break_entries = 0;
+    uint64_t actual_u_tests = 0, subset_pass = 0, subset_reject = 0;
+    uint64_t covered_actual_rejects = 0, retired_members = 0, certificate_violations = 0;
+
+    void Merge(const UFilterScaleTotals& other) {
+#define U_MERGE(field) field += other.field
+        U_MERGE(snapshot_groups); U_MERGE(snapshot_members);
+        U_MERGE(mask_rejected_groups); U_MERGE(mask_rejected_snapshot_members);
+        U_MERGE(loop_reached_groups); U_MERGE(u_test_reached_groups);
+        U_MERGE(loop_entries); U_MERGE(cost_break_entries);
+        U_MERGE(actual_u_tests); U_MERGE(subset_pass); U_MERGE(subset_reject);
+        U_MERGE(covered_actual_rejects); U_MERGE(retired_members); U_MERGE(certificate_violations);
+#undef U_MERGE
+    }
+    nlohmann::json ToJson() const {
+        return {{"snapshot_groups", snapshot_groups}, {"snapshot_members", snapshot_members},
+            {"mask_rejected_groups", mask_rejected_groups}, {"mask_rejected_snapshot_members", mask_rejected_snapshot_members},
+            {"loop_reached_groups", loop_reached_groups}, {"u_test_reached_groups", u_test_reached_groups},
+            {"loop_entries", loop_entries}, {"cost_break_entries", cost_break_entries},
+            {"actual_u_tests", actual_u_tests}, {"subset_pass", subset_pass}, {"subset_reject", subset_reject},
+            {"covered_actual_rejects", covered_actual_rejects}, {"retired_members", retired_members},
+            {"certificate_violations", certificate_violations}};
+    }
+};
+
+struct UFilterOpportunityTotals {
+    uint64_t sampled_calls = 0, depot_shortcut_calls = 0, u_relaxed_calls = 0, cost_relaxed_correction_calls = 0;
+    uint64_t bucket_entries = 0, demand_break_buckets = 0, u_relaxed_buckets = 0;
+    uint64_t bucket_snapshots = 0, empty_bucket_snapshots = 0, snapshot_label_reads = 0;
+    uint64_t finished_snapshots = 0, cost_break_snapshots = 0, early_elimination_snapshots = 0;
+    uint64_t unvisited_snapshot_members = 0, retired_labels = 0, membership_violations = 0;
+    std::array<UFilterScaleTotals, 4> scales{};
+
+    void Merge(const UFilterOpportunityTotals& other) {
+#define U_MERGE(field) field += other.field
+        U_MERGE(sampled_calls); U_MERGE(depot_shortcut_calls); U_MERGE(u_relaxed_calls); U_MERGE(cost_relaxed_correction_calls);
+        U_MERGE(bucket_entries); U_MERGE(demand_break_buckets); U_MERGE(u_relaxed_buckets);
+        U_MERGE(bucket_snapshots); U_MERGE(empty_bucket_snapshots); U_MERGE(snapshot_label_reads);
+        U_MERGE(finished_snapshots); U_MERGE(cost_break_snapshots); U_MERGE(early_elimination_snapshots);
+        U_MERGE(unvisited_snapshot_members); U_MERGE(retired_labels); U_MERGE(membership_violations);
+#undef U_MERGE
+        for (size_t i = 0; i < scales.size(); ++i) scales[i].Merge(other.scales[i]);
+    }
+    nlohmann::json ToJson() const {
+        nlohmann::json result = {{"sampled_calls", sampled_calls}, {"depot_shortcut_calls", depot_shortcut_calls},
+            {"u_relaxed_calls", u_relaxed_calls}, {"cost_relaxed_correction_calls", cost_relaxed_correction_calls},
+            {"bucket_entries", bucket_entries}, {"demand_break_buckets", demand_break_buckets}, {"u_relaxed_buckets", u_relaxed_buckets},
+            {"bucket_snapshots", bucket_snapshots}, {"empty_bucket_snapshots", empty_bucket_snapshots},
+            {"snapshot_label_reads", snapshot_label_reads}, {"finished_snapshots", finished_snapshots},
+            {"cost_break_snapshots", cost_break_snapshots}, {"early_elimination_snapshots", early_elimination_snapshots},
+            {"unvisited_snapshot_members", unvisited_snapshot_members}, {"retired_labels", retired_labels},
+            {"membership_violations", membership_violations}};
+        static constexpr const char* names[] = {"whole_bucket", "block16", "block32", "block64"};
+        for (size_t i = 0; i < scales.size(); ++i) result["scales"][names[i]] = scales[i].ToJson();
+        return result;
+    }
+};
+
+inline bool UFilterDemandBreak(UFilterOpportunityTotals* totals, bool result) {
+    if (totals && result) ++totals->demand_break_buckets;
+    return result;
+}
+
+// Fixed groups contain every bucket-entry label, even unvisited suffixes.
+// Correction erasures preserve order. A separate ordinal retains membership
+// rather than regrouping the shrinking vector at its current loop index.
+template<class Label>
+class UFilterBucketSnapshot {
+    using Mask = decltype(std::declval<Label>().U);
+    struct Group {
+        Mask mask;
+        size_t members = 0;
+        bool rejected = false, loop_reached = false, u_test_reached = false;
+    };
+    UFilterOpportunityTotals* totals_ = nullptr;
+    std::vector<const Label*> members_;
+    std::array<std::vector<Group>, 4> groups_;
+    size_t next_ = 0, current_ = 0;
+    bool member_valid_ = false, finished_ = false;
+    static size_t GroupIndex(size_t scale, size_t index) {
+        static constexpr size_t sizes[] = {0, 16, 32, 64};
+        return scale == 0 ? 0 : index / sizes[scale];
+    }
+public:
+    UFilterBucketSnapshot(UFilterOpportunityTotals* totals, const std::vector<Label*>& labels,
+                          const Mask& query, bool correction) : totals_(totals) {
+        if (!totals_) return;
+        ++totals_->bucket_snapshots;
+        if (labels.empty()) { ++totals_->empty_bucket_snapshots; return; }
+        members_.assign(labels.begin(), labels.end());
+        const size_t count = labels.size();
+        groups_[0].resize(1);
+        groups_[1].resize((count + 15) / 16);
+        groups_[2].resize((count + 31) / 32);
+        groups_[3].resize((count + 63) / 64);
+        for (size_t i = 0; i < count; ++i) {
+            ++totals_->snapshot_label_reads;
+            for (size_t scale = 0; scale < groups_.size(); ++scale) {
+                auto& group = groups_[scale][GroupIndex(scale, i)];
+                if (group.members++ == 0) group.mask = labels[i]->U;
+                else if (correction) group.mask |= labels[i]->U;
+                else group.mask &= labels[i]->U;
+            }
+        }
+        for (size_t scale = 0; scale < groups_.size(); ++scale) {
+            auto& stats = totals_->scales[scale];
+            for (auto& group : groups_[scale]) {
+                group.rejected = correction ? ((query & group.mask) != query) : ((group.mask & query) != group.mask);
+                ++stats.snapshot_groups;
+                stats.snapshot_members += group.members;
+                if (group.rejected) {
+                    ++stats.mask_rejected_groups;
+                    stats.mask_rejected_snapshot_members += group.members;
+                }
+            }
+        }
+    }
+    void Visit(const Label* label) {
+        if (!totals_) return;
+        current_ = next_++;
+        member_valid_ = current_ < members_.size() && members_[current_] == label;
+        if (!member_valid_) { ++totals_->membership_violations; return; }
+        for (size_t scale = 0; scale < groups_.size(); ++scale) {
+            auto& group = groups_[scale][GroupIndex(scale, current_)];
+            auto& stats = totals_->scales[scale];
+            ++stats.loop_entries;
+            if (!group.loop_reached) { group.loop_reached = true; ++stats.loop_reached_groups; }
+        }
+    }
+    bool CostBreak(bool result) {
+        if (totals_ && result) {
+            ++totals_->cost_break_snapshots;
+            if (member_valid_) for (auto& scale : totals_->scales) ++scale.cost_break_entries;
+        }
+        return result;
+    }
+    bool SubsetRejected(bool rejected) {
+        if (!totals_ || !member_valid_) return rejected;
+        for (size_t scale = 0; scale < groups_.size(); ++scale) {
+            auto& group = groups_[scale][GroupIndex(scale, current_)];
+            auto& stats = totals_->scales[scale];
+            ++stats.actual_u_tests;
+            if (rejected) ++stats.subset_reject;
+            else ++stats.subset_pass;
+            if (!group.u_test_reached) { group.u_test_reached = true; ++stats.u_test_reached_groups; }
+            if (group.rejected) {
+                if (rejected) ++stats.covered_actual_rejects;
+                else ++stats.certificate_violations;
+            }
+        }
+        return rejected;
+    }
+    void Retire() {
+        if (!totals_) return;
+        ++totals_->retired_labels;
+        if (member_valid_) for (auto& scale : totals_->scales) ++scale.retired_members;
+    }
+    void Finish(bool early_elimination = false) {
+        if (!totals_ || finished_) return;
+        ++totals_->finished_snapshots;
+        if (early_elimination) ++totals_->early_elimination_snapshots;
+        if (next_ <= members_.size()) totals_->unvisited_snapshot_members += members_.size() - next_;
+        finished_ = true;
+    }
+};
+} // namespace solver
+#endif
