+using namespace goc;
+using namespace nyr;
+using namespace solver;
+namespace solver {
+struct CorrectionInvariantTest {
+    static MonodirectionalLabeling& Mono(BidirectionalLabeling& b) { return b.lbl_[0]; }
+    static void Process(MonodirectionalLabeling& m, Label* l) { m.ProcessStep(l); }
+    static bool Dominated(MonodirectionalLabeling& m, Label* l) { return m.DominationStep(l); }
+    static int Correct(MonodirectionalLabeling& m, Label* l) { return m.CorrectionStep(l); }
+    static void Clean(MonodirectionalLabeling& m) { m.Clean(); }
+    static auto& Retired(MonodirectionalLabeling& m) { return m.retired_labels_; }
+    static auto& Dirty(MonodirectionalLabeling& m) { return m.corrected_merge_buckets_; }
+    static void Configure(MonodirectionalLabeling& m) { m.pp_.P.assign(5, 0); m.pp_.sigma = {.125, -.375, .5}; }
+    static void RetireAt(MonodirectionalLabeling& m, int vertex, double demand, size_t index) {
+        auto& labels = m.U[vertex].Insert(demand, {});
+        m.retired_labels_.push_back(labels[index]);
+#ifdef KAYROS_PACKED_ORDINARY_FILTER
+        m.packed_ordinary_filter_.Erase(vertex, demand, index, labels.size());
+#endif
+        labels.erase(labels.begin() + index);
+    }
+#ifdef KAYROS_PACKED_ORDINARY_FILTER
+    static auto& Index(MonodirectionalLabeling& m) { return m.packed_ordinary_filter_; }
+#endif
+};
+}
+namespace {
+void require(bool value, const char* message) { if (!value) throw std::runtime_error(message); }
+VRPInstance instance() {
+    VRPInstance vrp;
+    vrp.D = Digraph(5); vrp.o = 0; vrp.d = 4; vrp.T = 20; vrp.horizon = {0., 20.}; vrp.Q = 1000;
+    vrp.q.assign(5, 0.); vrp.tw.assign(5, {0., 20.});
+    vrp.tau = Matrix<PWLFunction>(5, 5); vrp.pretau = Matrix<PWLFunction>(5, 5);
+    vrp.arr = Matrix<PWLFunction>(5, 5); vrp.dep = Matrix<PWLFunction>(5, 5); vrp.LDT = Matrix<double>(5, 5);
+    vrp.tau[0][0] = PWLFunction::ConstantFunction(0., {0., 20.}); return vrp;
+}
+PWLFunction function(int kind, double value) {
+    PWLFunction f;
+    switch (kind % 6) {
+    case 0: return PWLFunction::ConstantFunction(value, {0., 10.});
+    case 1: f.AddPiece(LinearFunction({0., value}, {10., value + 5.})); break;
+    case 2: f.AddPiece(LinearFunction({0., value + 4.}, {10., value})); break;
+    case 3: f.AddPiece(LinearFunction({0., value}, {3., value + 1.}));
+            f.AddPiece(LinearFunction({6., value + 2.}, {10., value + 1.})); break;
+    case 4: return PWLFunction::ConstantFunction(value, {3., 3.});
+    case 5: f.AddPiece(LinearFunction({0., value + 3.}, {0., value + 1.}).as_choice_vertical());
+            f.AddPiece(LinearFunction({0., value + 1.}, {5., value + 2.}));
+            f.AddPiece(LinearFunction({5., value + 2.}, {5., value}).as_choice_vertical());
+            f.AddPiece(LinearFunction({5., value}, {5., value + .5}).as_choice_vertical()); break;
+    }
+    return f;
+}
+Label label(int kind, double value, double demand, uint64_t mask, bool cuts) {
+    Label l;
+    l.parent = nullptr; l.v = 1; l.q = demand; l.p = cuts ? .25 : 0.; l.cut_cost = 0.; l.length = kind % 4;
+    l.S.set(0); l.U = VertexSet(mask); l.duration = function(kind, value); l.rw = l.duration.Domain();
+    l.cut_visited = cuts ? std::vector<int>{1 + kind % 3, (kind + 1) % 3, kind % 2} : std::vector<int>{0, 0, 0};
+    const double sigma[] = {.125, -.375, .5};
+    for (int i = 0; i < 3; ++i) {
+        if (l.cut_visited[i] % 2) l.cut_nz.push_back(i);
+        l.cut_cost += (l.cut_visited[i] / 2) * sigma[i];
+    }
+    l.min_cost = min(img(l.duration)) - l.p - l.cut_cost;
+    return l;
+}
+struct Context {
+    std::optional<TDNGRoutesParams> ng;
+    BidirectionalLabeling bidi;
+    std::map<const Label*, uint64_t> ids;
+    uint64_t next = 1;
+    explicit Context(bool enabled) : ng(std::nullopt), bidi(instance(), ng) {
+        auto& m = mono(); m.partial = m.sort_by_cost = true; m.elementary_check_relaxation = m.cost_check_relaxation = false;
+        CorrectionInvariantTest::Configure(m);
+#ifdef KAYROS_PACKED_ORDINARY_FILTER
+        m.packed_ordinary_filter_enabled = enabled;
+#else
+        (void)enabled;
+#endif
+    }
+    MonodirectionalLabeling& mono() { return CorrectionInvariantTest::Mono(bidi); }
+    void insert(const Label& value) {
+        auto* l = new Label(value); ids.emplace(l, next++); CorrectionInvariantTest::Process(mono(), l);
+    }
+    void clean(bool set_problem = false) {
+        if (set_problem) { PricingProblem pp; pp.P.assign(5, 0.); mono().SetProblem(pp); }
+        else CorrectionInvariantTest::Clean(mono());
+        ids.clear(); CorrectionInvariantTest::Configure(mono());
+    }
+    void verify() {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER
+        for (int v = 0; v < mono().U.size(); ++v) for (const auto& demand : mono().U[v])
+            require(CorrectionInvariantTest::Index(mono()).Verify(v, demand.first, demand.second), "Cached U/min_cost/order differs");
+#endif
+    }
+};
+void integer(std::ostringstream& out, uint64_t value) { out << std::hex << value << ','; }
+void number(std::ostringstream& out, double value) { integer(out, std::bit_cast<uint64_t>(value)); }
+void record_label(std::ostringstream& out, const Label& l, const Context& c) {
+    integer(out, l.parent ? c.ids.at(l.parent) : 0); integer(out, l.v); integer(out, l.length);
+    number(out, l.q); number(out, l.p); number(out, l.cut_cost); number(out, l.min_cost);
+    number(out, l.rw.left); number(out, l.rw.right);
+    for (size_t i = 0; i < l.U.size(); ++i) { integer(out, l.U.test(i)); integer(out, l.S.test(i)); }
+    integer(out, l.cut_visited.size()); for (auto x : l.cut_visited) integer(out, x);
+    integer(out, l.cut_nz.size()); for (auto x : l.cut_nz) integer(out, x);
+    integer(out, l.duration.PieceCount());
+    for (const auto& p : l.duration.Pieces()) {
+        number(out, p.domain.left); number(out, p.domain.right); number(out, p.image.left); number(out, p.image.right);
+        number(out, p.slope); number(out, p.intercept);
+    }
+}
+std::string state(Context& c, const Label* query = nullptr, int result = -1) {
+    c.verify(); auto& m = c.mono(); std::ostringstream out;
+    integer(out, m.partial); integer(out, m.sort_by_cost); integer(out, m.elementary_check_relaxation); integer(out, m.cost_check_relaxation);
+    integer(out, result);
+    for (int v = 0; v < m.U.size(); ++v) {
+        integer(out, v);
+        for (const auto& demand : m.U[v]) {
+            number(out, demand.first); integer(out, demand.second.size());
+            for (const Label* l : demand.second) { integer(out, c.ids.at(l)); record_label(out, *l, c); }
+        }
+    }
+    integer(out, CorrectionInvariantTest::Retired(m).size());
+    for (const auto* l : CorrectionInvariantTest::Retired(m)) { integer(out, c.ids.at(l)); record_label(out, *l, c); }
+    integer(out, CorrectionInvariantTest::Dirty(m).size());
+    for (const auto& key : CorrectionInvariantTest::Dirty(m)) { integer(out, key.first); number(out, key.second); }
+    if (query) record_label(out, *query, c);
+    return out.str();
+}
+uint64_t digest = 1469598103934665603ULL, comparisons = 0;
+void same(const std::string& a, const std::string& b) {
+    require(a == b, "Full semantic state differs between scalar and packed calls");
+    for (unsigned char ch : a) { digest ^= ch; digest *= 1099511628211ULL; }
+    ++comparisons;
+}
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+void same_trace(Context& a, Context& b) {
+    const auto& x = CorrectionInvariantTest::Index(a.mono()).trace;
+    const auto& y = CorrectionInvariantTest::Index(b.mono()).trace;
+    require(x.size() == y.size(), "Query bucket trace count changed");
+    for (size_t i = 0; i < x.size(); ++i)
