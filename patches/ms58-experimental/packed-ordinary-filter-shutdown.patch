+}
+#endif
+void query(Context& a, Context& b, Label value) {
+    Label x = value, y = value;
+    const bool dx = CorrectionInvariantTest::Dominated(a.mono(), &x), dy = CorrectionInvariantTest::Dominated(b.mono(), &y);
+    same(state(a, &x, dx), state(b, &y, dy));
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+    same_trace(a, b);
+#endif
