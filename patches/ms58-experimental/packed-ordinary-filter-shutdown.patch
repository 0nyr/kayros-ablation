diff --git a/cpp/lera/main/include/labeling/packed_ordinary_filter.h b/cpp/lera/main/include/labeling/packed_ordinary_filter.h
new file mode 100644
index 0000000..315c78c
--- /dev/null
+++ b/cpp/lera/main/include/labeling/packed_ordinary_filter.h
@@ -0,0 +1,210 @@
+#pragma once
+#ifdef KAYROS_PACKED_ORDINARY_FILTER
+#include <bit>
+#include <cstdint>
+#include <map>
+#include <new>
+#include <vector>
+#include "label.h"
+
+namespace solver {
+class PackedOrdinaryFilter {
+public:
+    struct Row { nyr::VertexSet U; double min_cost; };
+    using Key = std::pair<goc::Vertex, nyr::CapacityUnit>;
+    static constexpr size_t Threshold = 64;
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+    struct Statistics {
+        uint64_t rows_built = 0, rebuilds = 0, insertions = 0, erasures = 0, value_refreshes = 0;
+        uint64_t insertion_shift_bytes = 0, erasure_shift_bytes = 0, growth_events = 0, growth_prior_payload_bytes = 0;
+        uint64_t invalidations = 0, size_mismatches = 0, allocation_failures = 0;
+        uint64_t packed_queries = 0, scalar_queries = 0, packed_visits = 0, packed_u_tests = 0, packed_survivor_dereferences = 0;
+        uint64_t current_live_rows = 0, current_capacity_rows = 0, peak_live_rows = 0, peak_capacity_rows = 0, current_buckets = 0;
+    };
+    struct BucketTrace {
+        Key key;
+        bool packed;
+        std::vector<size_t> visits, u_tests, survivors;
+        size_t cost_break = static_cast<size_t>(-1);
+        bool operator==(const BucketTrace&) const = default;
+    };
+    mutable Statistics statistics;
+    mutable std::vector<BucketTrace> trace;
+    mutable bool fail_next_optional_allocation = false;
+#endif
+private:
+    struct Bucket { std::vector<Row> rows; bool valid = false; };
+    mutable std::map<Key, Bucket> buckets_;
+    mutable bool allocation_disabled_ = false;
+    void Memory() const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        uint64_t live = 0, capacity = 0;
+        for (const auto& entry : buckets_) { live += entry.second.rows.size(); capacity += entry.second.rows.capacity(); }
+        statistics.current_live_rows = live; statistics.current_capacity_rows = capacity;
+        statistics.peak_live_rows = std::max(statistics.peak_live_rows, live);
+        statistics.peak_capacity_rows = std::max(statistics.peak_capacity_rows, capacity);
+        statistics.current_buckets = buckets_.size();
+#endif
+    }
+    void FailedAllocation() const noexcept {
+        buckets_.clear(); allocation_disabled_ = true;
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        ++statistics.allocation_failures;
+        statistics.current_live_rows = statistics.current_capacity_rows = statistics.current_buckets = 0;
+#endif
+    }
+    void Invalidate(Bucket& bucket) const {
+        bucket.valid = false; bucket.rows.clear();
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        ++statistics.invalidations;
+#endif
+        Memory();
+    }
+    bool Shape(Bucket& bucket, size_t expected) const {
+        if (bucket.rows.size() == expected) return true;
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        ++statistics.size_mismatches;
+#endif
+        Invalidate(bucket); return false;
+    }
+    void MaybeFailForFixture() const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        if (fail_next_optional_allocation) { fail_next_optional_allocation = false; throw std::bad_alloc(); }
+#endif
+    }
+    void Build(Bucket& bucket, const std::vector<Label*>& labels) const {
+        MaybeFailForFixture();
+        bucket.valid = false;
+        std::vector<Row> complete;
+        complete.reserve(labels.size());
+        for (const Label* label : labels) complete.push_back({label->U, label->min_cost});
+        bucket.rows.swap(complete);
+        bucket.valid = true; // Publish only a complete copy in current order.
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        ++statistics.rebuilds; statistics.rows_built += labels.size();
+#endif
+        Memory();
+    }
+public:
+    // Metadata owns values only. Allocation failure never rolls back an
+    // already successful algorithm mutation and disables rebuilding until Clean.
+    void Clear() noexcept {
+        buckets_.clear(); allocation_disabled_ = false;
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        fail_next_optional_allocation = false;
+#endif
+        Memory();
+    }
+    bool AllocationDisabled() const { return allocation_disabled_; }
+    void Insert(goc::Vertex vertex, nyr::CapacityUnit demand, size_t index,
+                const std::vector<Label*>& labels, bool create) noexcept {
+        if (allocation_disabled_) return;
+        const Key key{vertex, demand};
+        try {
+            auto it = buckets_.find(key);
+            if (it == buckets_.end()) {
+                if (!create) return;
+                MaybeFailForFixture();
+                it = buckets_.try_emplace(key).first;
+                Build(it->second, labels); return;
+            }
+            auto& bucket = it->second;
+            if (!bucket.valid) { if (create) Build(bucket, labels); return; }
+            if (labels.empty() || index >= labels.size()) { Invalidate(bucket); return; }
+            if (!Shape(bucket, labels.size() - 1)) return;
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+            const auto previous_capacity = bucket.rows.capacity();
+            const auto previous_size = bucket.rows.size();
+#endif
+            MaybeFailForFixture();
+            bucket.rows.insert(bucket.rows.begin() + index, {labels[index]->U, labels[index]->min_cost});
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+            ++statistics.insertions;
+            statistics.insertion_shift_bytes += (previous_size - index) * sizeof(Row);
+            if (bucket.rows.capacity() != previous_capacity) {
+                ++statistics.growth_events; statistics.growth_prior_payload_bytes += previous_size * sizeof(Row);
+            }
+#endif
+            Memory();
+        } catch (const std::bad_alloc&) { FailedAllocation(); }
+    }
+    void Refresh(goc::Vertex vertex, nyr::CapacityUnit demand, size_t index,
+                 size_t size, double value) noexcept {
+        auto it = buckets_.find({vertex, demand});
+        if (it == buckets_.end() || !it->second.valid) return;
+        auto& bucket = it->second;
+        if (!Shape(bucket, size)) return;
+        if (index >= size) { Invalidate(bucket); return; }
+        bucket.rows[index].min_cost = value; // Copy even equal values and signed zero.
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        ++statistics.value_refreshes;
+#endif
+    }
+    void Erase(goc::Vertex vertex, nyr::CapacityUnit demand, size_t index, size_t size) noexcept {
+        auto it = buckets_.find({vertex, demand});
+        if (it == buckets_.end() || !it->second.valid) return;
+        auto& bucket = it->second;
+        if (!Shape(bucket, size)) return;
+        if (index >= size) { Invalidate(bucket); return; }
+        bucket.rows.erase(bucket.rows.begin() + index);
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        ++statistics.erasures; statistics.erasure_shift_bytes += (size - index - 1) * sizeof(Row);
+#endif
+        Memory();
+    }
+    void Invalidate(goc::Vertex vertex, nyr::CapacityUnit demand) noexcept {
+        auto it = buckets_.find({vertex, demand});
+        if (it != buckets_.end()) Invalidate(it->second);
+    }
+    const std::vector<Row>* Rows(goc::Vertex vertex, nyr::CapacityUnit demand,
+                                 const std::vector<Label*>& labels) const noexcept {
+        if (allocation_disabled_) return nullptr;
+        auto it = buckets_.find({vertex, demand});
+        if (it == buckets_.end()) return nullptr; // Absent sidecars retain scalar fallback.
+        auto& bucket = it->second;
+        if (bucket.valid && !Shape(bucket, labels.size())) return nullptr;
+        if (!bucket.valid) {
+            try { Build(bucket, labels); } catch (const std::bad_alloc&) { FailedAllocation(); return nullptr; }
+        }
+        return &bucket.rows;
+    }
+    bool Verify(goc::Vertex vertex, nyr::CapacityUnit demand, const std::vector<Label*>& labels) const {
+        auto it = buckets_.find({vertex, demand});
+        if (it == buckets_.end() || !it->second.valid) return true;
+        if (it->second.rows.size() != labels.size()) return false;
+        for (size_t i = 0; i < labels.size(); ++i)
+            if (it->second.rows[i].U != labels[i]->U || std::bit_cast<uint64_t>(it->second.rows[i].min_cost) !=
+                std::bit_cast<uint64_t>(labels[i]->min_cost)) return false;
+        return true;
+    }
+    void BeginQuery() const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        trace.clear();
+#endif
+    }
+    void BeginBucket(goc::Vertex vertex, nyr::CapacityUnit demand, bool packed) const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        trace.push_back({{vertex, demand}, packed, {}, {}, {}});
+        if (packed) ++statistics.packed_queries; else ++statistics.scalar_queries;
+#endif
+    }
+    void Visit(size_t index, bool packed) const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        trace.back().visits.push_back(index); if (packed) ++statistics.packed_visits;
+#endif
+    }
+    void CostBreak(size_t index) const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        trace.back().cost_break = index;
+#endif
+    }
+    void Subset(size_t index, bool packed, bool passed) const {
+#ifdef KAYROS_PACKED_ORDINARY_FILTER_METRICS
+        trace.back().u_tests.push_back(index);
+        if (passed) trace.back().survivors.push_back(index);
+        if (packed) { ++statistics.packed_u_tests; if (passed) ++statistics.packed_survivor_dereferences; }
+#endif
+    }
+};
+} // namespace solver
+#endif
