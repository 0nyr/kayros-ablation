new file mode 100644
index 0000000..4a79d81
--- /dev/null
+++ b/cpp/lera/main/include/labeling/correction_u_blocks.h
@@ -0,0 +1,221 @@
+#ifndef KAYROS_CORRECTION_U_BLOCKS_H
+#define KAYROS_CORRECTION_U_BLOCKS_H
+
+#include <algorithm>
+#include <cstddef>
+#include <map>
+#include <new>
+#include <utility>
+#include <vector>
+
+#include "label.h"
+
+namespace solver {
+
+// Optional correction index. Keys and masks own their values. No cached bucket,
+// vector or label pointers survive VectorMap relocation or label retirement.
+class CorrectionUBlocks {
+public:
+    static constexpr std::size_t target = 16, split_above = 32, minimum = 64;
+    using Key = std::pair<goc::Vertex, nyr::CapacityUnit>;
+    using Labels = std::vector<Label*>;
+    struct Group {
+        nyr::VertexSet mask;
+        std::size_t live = 0;
+    };
+    struct Bucket {
+        std::vector<Group> groups;
+        std::size_t live = 0;
+    };
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+    struct Metrics {
+        std::size_t group_checks = 0, skipped_tests = 0, insertions = 0;
+        std::size_t rebuilds = 0, rebuild_reads = 0, split_reads = 0;
+        std::size_t erasures = 0, splits = 0, merges = 0;
+        std::size_t allocation_attempts = 0, allocation_failures = 0;
+        std::size_t live_bytes = 0, capacity_bytes = 0, peak_capacity_bytes = 0;
+        std::size_t checked_mask_bits = 0, conservative_excess_bits = 0;
+    } metrics;
+#endif
+
+    void Invalidate() noexcept {
+        buckets_.clear();
+        Memory();
+    }
+    void Invalidate(Key key) noexcept {
+        buckets_.erase(key);
+        Memory();
+    }
+    void Clean() noexcept {
+        Invalidate();
+        disabled_ = false;
+        fail_after_ = -1;
+    }
+    bool Disabled() const noexcept { return disabled_; }
+    // Native failure injection targets optional allocation sites only.
+    void FailAllocationAfterForTesting(long count) noexcept { fail_after_ = count; }
+    Bucket* Find(Key key, std::size_t size) noexcept {
+        auto it = buckets_.find(key);
+        if (it == buckets_.end()) return nullptr;
+        if (it->second.live != size || it->second.groups.empty()) {
+            buckets_.erase(it);
+            Memory();
+            return nullptr;
+        }
+        return &it->second;
+    }
+
+    void Rebuild(Key key, const Labels& labels) noexcept {
+        if (disabled_) return;
+        if (labels.size() < minimum) {
+            buckets_.erase(key);
+            Memory();
+            return;
+        }
+        try {
+            Bucket next;
+            Allocation();
+            next.groups.reserve((labels.size() + target - 1) / target);
+            for (std::size_t first = 0; first < labels.size(); first += target)
+                next.groups.push_back(Summary(labels, first, std::min(target, labels.size() - first)));
+            next.live = labels.size();
+            auto it = buckets_.find(key);
+            if (it == buckets_.end()) {
+                Allocation();
+                buckets_.emplace(key, std::move(next));
+            } else {
+                it->second.groups.swap(next.groups);
+                it->second.live = next.live;
+            }
+            CountRebuild(labels.size());
+            Memory();
+        } catch (const std::bad_alloc&) { AllocationFailed(); }
+    }
+
+    // The mandatory upper_bound insertion has already succeeded. At a boundary,
+    // the inserted label belongs to the group on its right, except at bucket end.
+    void Inserted(Key key, const Labels& labels, std::size_t position) noexcept {
+        if (disabled_) return;
+        auto it = buckets_.find(key);
+        if (it == buckets_.end()) { Rebuild(key, labels); return; }
+        auto& bucket = it->second;
+        if (bucket.live + 1 != labels.size()) {
+            buckets_.erase(it);
+            Memory();
+            return;
+        }
+        std::size_t first = 0, g = 0;
+        while (g + 1 < bucket.groups.size() && position >= first + bucket.groups[g].live) {
+            first += bucket.groups[g].live;
+            ++g;
+        }
+        auto& group = bucket.groups[g];
+        group.mask |= labels[position]->U;
+        ++group.live;
+        ++bucket.live;
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        ++metrics.insertions;
+#endif
+        if (group.live > split_above) {
+            try {
+                const std::size_t left = group.live / 2, right = group.live - left;
+                const auto a = Summary(labels, first, left);
+                const auto b = Summary(labels, first + left, right);
+                if (bucket.groups.size() == bucket.groups.capacity()) Allocation();
+                bucket.groups.insert(bucket.groups.begin() + g + 1, b);
+                bucket.groups[g] = a;
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+                ++metrics.splits;
+                metrics.split_reads += left + right;
+#endif
+            } catch (const std::bad_alloc&) { AllocationFailed(); return; }
+        }
+        Memory();
+    }
+
+    static void Erased(Bucket& bucket, std::size_t group) noexcept {
+        --bucket.groups[group].live;
+        --bucket.live;
+    }
+    void CountErase() noexcept {
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        ++metrics.erasures;
+#endif
+    }
+    void Finish(Bucket& bucket) noexcept {
+        auto& groups = bucket.groups;
+        groups.erase(std::remove_if(groups.begin(), groups.end(),
+            [](const Group& group) { return group.live == 0; }), groups.end());
+        for (std::size_t g = 0; g + 1 < groups.size();) {
+            if (groups[g].live + groups[g + 1].live <= target) {
+                groups[g].mask |= groups[g + 1].mask;
+                groups[g].live += groups[g + 1].live;
+                groups.erase(groups.begin() + g + 1);
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+                ++metrics.merges;
+#endif
+            } else ++g;
+        }
+        Memory();
+    }
+
+    bool Reject(const Group& group, const nyr::VertexSet& arriving,
+                const Labels& labels, std::size_t first) noexcept {
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        ++metrics.group_checks;
+        nyr::VertexSet exact;
+        for (std::size_t i = first; i < first + group.live; ++i) exact |= labels[i]->U;
+        metrics.checked_mask_bits += group.mask.count();
+        metrics.conservative_excess_bits += (group.mask & ~exact).count();
+#endif
+        const bool rejected = (arriving & ~group.mask).any();
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        if (rejected) metrics.skipped_tests += group.live;
+#endif
+        return rejected;
+    }
+
+private:
+    std::map<Key, Bucket> buckets_;
+    bool disabled_ = false;
+    long fail_after_ = -1;
+
+    static Group Summary(const Labels& labels, std::size_t first, std::size_t length) noexcept {
+        Group group{{}, length};
+        for (std::size_t i = first; i < first + length; ++i) group.mask |= labels[i]->U;
+        return group;
+    }
+    void Allocation() {
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        ++metrics.allocation_attempts;
+#endif
+        if (fail_after_ == 0) throw std::bad_alloc();
+        if (fail_after_ > 0) --fail_after_;
+    }
+    void AllocationFailed() noexcept {
+        disabled_ = true;
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        ++metrics.allocation_failures;
+#endif
+        Invalidate();
+    }
+    void CountRebuild(std::size_t size) noexcept {
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        ++metrics.rebuilds;
+        metrics.rebuild_reads += size;
+#endif
+    }
+    void Memory() noexcept {
+#ifdef KAYROS_CORRECTION_U_BLOCK_METRICS
+        // Payload and vector capacity, excluding allocator and map-node overhead.
+        metrics.live_bytes = metrics.capacity_bytes = buckets_.size() * sizeof(typename decltype(buckets_)::value_type);
+        for (const auto& [key, bucket] : buckets_) {
+            metrics.live_bytes += bucket.groups.size() * sizeof(Group);
+            metrics.capacity_bytes += bucket.groups.capacity() * sizeof(Group);
+        }
+        metrics.peak_capacity_bytes = std::max(metrics.peak_capacity_bytes, metrics.capacity_bytes);
+#endif
+    }
+};
+}
+#endif
