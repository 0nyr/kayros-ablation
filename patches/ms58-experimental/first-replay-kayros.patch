diff --git a/cpp/lera/bridge/pricing_trace.h b/cpp/lera/bridge/pricing_trace.h
new file mode 100644
index 0000000..3804c79
--- /dev/null
+++ b/cpp/lera/bridge/pricing_trace.h
@@ -0,0 +1,132 @@
+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <cmath>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "goc/lib/json.hpp"
+
+namespace kayros::lera {
+
+// Opt-in development trace. Every complete JSONL record is flushed before
+// returning to the solver. An unmatched begin record carries no completion
+// claim, and a killed write can leave one incomplete final line.
+class PricingTrace {
+public:
+    PricingTrace() {
+        const char* path = std::getenv("KAYROS_PRICING_TRACE");
+        if (path && *path) {
+            file_ = std::fopen(path, "wx");
+            if (!file_) throw std::runtime_error("Cannot exclusively create KAYROS_PRICING_TRACE");
+        }
+    }
+    ~PricingTrace() { if (file_) std::fclose(file_); }
+    PricingTrace(const PricingTrace&) = delete;
+    PricingTrace& operator=(const PricingTrace&) = delete;
+    explicit operator bool() const { return file_ != nullptr; }
+
+    // FNV-1a over JSON bytes is a diagnostic fingerprint, not an artifact digest.
+    static uint64_t fingerprint(const std::string& value) {
+        uint64_t result = UINT64_C(14695981039346656037);
+        for (unsigned char c : value) {
+            result ^= c;
+            result *= UINT64_C(1099511628211);
+        }
+        return result;
+    }
+
+    static double monotonic_seconds() {
+        return std::chrono::duration<double>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    void emit(nlohmann::json record) {
+        if (!file_) return;
+        record["schema_version"] = 1;
+        record["monotonic_s"] = monotonic_seconds();
+        const std::string line = record.dump() + '\n';
+        if (std::fwrite(line.data(), 1, line.size(), file_) != line.size()
+            || std::fflush(file_) != 0)
+            throw std::runtime_error("Cannot flush KAYROS_PRICING_TRACE");
+    }
+
+private:
+    std::FILE* file_ = nullptr;
+};
+
+// A root-pricing experiment, deliberately terminated before column admission.
+// It replaces only the dual vector, so an identical captured vector can be
+// compared across implementations without making a solve or closure claim.
+class FirstPricingReplay {
+public:
+    explicit FirstPricingReplay(bool trace_enabled) {
+        const char* path = std::getenv("KAYROS_FIRST_PRICING_REPLAY");
+        if (!path || !*path) return;
+        if (!trace_enabled)
+            throw std::runtime_error("KAYROS_FIRST_PRICING_REPLAY requires KAYROS_PRICING_TRACE");
+        std::ifstream input(path);
+        if (!input) throw std::runtime_error("Cannot read KAYROS_FIRST_PRICING_REPLAY");
+        nlohmann::json fixture;
+        input >> fixture;
+        if (fixture.at("schema_version") != 1)
+            throw std::runtime_error("Unsupported first pricing replay schema");
+        context_ = fixture.at("context");
+        for (const char* key : {"forbidden_arcs", "cuts", "cuts_duals"}) {
+            if (!context_.at(key).is_array() || !context_.at(key).empty())
+                throw std::runtime_error("First pricing replay requires an unconstrained root task");
+        }
+        if (!context_.at("profits").is_array())
+            throw std::runtime_error("First pricing replay profits must be an array");
+        for (const auto& profit : context_.at("profits")) {
+            if (!profit.is_number() || !std::isfinite(profit.get<double>()))
+                throw std::runtime_error("First pricing replay profits must be finite numbers");
+        }
+        enabled_ = true;
+    }
+
+    explicit operator bool() const { return enabled_; }
+
+    void apply(const nlohmann::json& original, std::vector<double>& profits) {
+        if (!enabled_ || used_)
+            throw std::runtime_error("First pricing replay invoked outside its single root call");
+        if (profits.size() != context_.at("profits").size())
+            throw std::runtime_error("First pricing replay vertex count mismatch");
+        for (const char* key : {"forbidden_arcs", "cuts", "cuts_duals"}) {
+            if (original.at(key) != context_.at(key))
+                throw std::runtime_error("First pricing replay root context mismatch");
+        }
+        profits = context_.at("profits").get<std::vector<double>>();
+        used_ = true;
+    }
+
+    [[noreturn]] void finish(PricingTrace& trace) const {
+        trace.emit({{"event", "replay_complete"}, {"call", 1},
+                    {"solver_claim", false}, {"correcting", false}});
+        throw std::runtime_error("MS58_FIRST_PRICING_REPLAY_COMPLETE: intentional diagnostic stop");
+    }
+
+private:
+    bool enabled_ = false;
+    bool used_ = false;
+    nlohmann::json context_;
+};
+
+template<class Instance>
+nlohmann::json replay_instance(const Instance& vrp) {
+    nlohmann::json successors = nlohmann::json::array();
+    for (auto vertex : vrp.D.Vertices()) successors.push_back(vrp.D.Successors(vertex));
+    return {{"event", "replay_instance"}, {"successors", successors},
+            {"start_depot", vrp.o}, {"end_depot", vrp.d}, {"horizon", vrp.T},
+            {"time_windows", vrp.tw}, {"capacity", vrp.Q}, {"demands", vrp.q},
+            {"travel_times", vrp.tau}, {"arrival_times", vrp.arr},
+            {"departure_times", vrp.dep}, {"pretravel_times", vrp.pretau},
+            {"latest_departure", vrp.LDT}};
+}
+
+}  // namespace kayros::lera
diff --git a/tests/pricing_trace_smoke.cpp b/tests/pricing_trace_smoke.cpp
new file mode 100644
index 0000000..06a7772
--- /dev/null
+++ b/tests/pricing_trace_smoke.cpp
@@ -0,0 +1,30 @@
+#include "../cpp/lera/bridge/pricing_trace.h"
+
+#include <cassert>
+#include <fstream>
+#include <string>
+
+int main(int argc, char** argv) {
+    assert(argc == 2);
+    unsetenv("KAYROS_PRICING_TRACE");
+    assert(!kayros::lera::PricingTrace());
+    setenv("KAYROS_PRICING_TRACE", argv[1], 1);
+    kayros::lera::PricingTrace trace;
+    assert(trace);
+    trace.emit({{"event", "pricing_begin"}, {"call", 1}});
+    // Read before destruction to verify immediate flushing. No end is invented.
+    std::ifstream input(argv[1]);
+    std::string line;
+    assert(std::getline(input, line));
+    auto record = nlohmann::json::parse(line);
+    assert(record.at("event") == "pricing_begin");
+    assert(record.at("call") == 1);
+    assert(record.at("schema_version") == 1);
+    assert(record.at("monotonic_s").get<double>() > 0.0);
+    assert(!std::getline(input, line));
+    bool refused_existing = false;
+    try { kayros::lera::PricingTrace second; }
+    catch (const std::runtime_error&) { refused_existing = true; }
+    assert(refused_existing);
+    assert(kayros::lera::PricingTrace::fingerprint("a") == UINT64_C(12638187200555641996));
+}
