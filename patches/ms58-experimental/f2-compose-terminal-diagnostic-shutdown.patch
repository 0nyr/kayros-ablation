index 0000000..55f8a73
--- /dev/null
+++ b/code/goc/src/math/diagnostic_input.cpp
@@ -0,0 +1,48 @@
+#include "goc/math/pwl_diagnostic.h"
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <vector>
+namespace goc { namespace pwl_diag {
+std::string sha256_bytes(const std::string& input) {
+    static const std::uint32_t k[64]={
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    auto rotate=[](std::uint32_t x,int n){return (x>>n)|(x<<(32-n));};
+    std::vector<unsigned char> data(input.begin(),input.end());
+    const std::uint64_t length=static_cast<std::uint64_t>(data.size())*8;
+    data.push_back(0x80);while(data.size()%64!=56)data.push_back(0);
+    for(int i=7;i>=0;--i)data.push_back(static_cast<unsigned char>(length>>(8*i)));
+    std::uint32_t h[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+    for(std::size_t offset=0;offset<data.size();offset+=64) {
+        std::uint32_t w[64];
+        for(int i=0;i<16;++i)w[i]=(std::uint32_t(data[offset+4*i])<<24)|(std::uint32_t(data[offset+4*i+1])<<16)|
+            (std::uint32_t(data[offset+4*i+2])<<8)|data[offset+4*i+3];
+        for(int i=16;i<64;++i) {auto s0=rotate(w[i-15],7)^rotate(w[i-15],18)^(w[i-15]>>3);auto s1=rotate(w[i-2],17)^rotate(w[i-2],19)^(w[i-2]>>10);w[i]=w[i-16]+s0+w[i-7]+s1;}
+        auto a=h[0],b=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],z=h[7];
+        for(int i=0;i<64;++i) {auto s1=rotate(e,6)^rotate(e,11)^rotate(e,25);auto ch=(e&f)^(~e&g);
+            auto t1=z+s1+ch+k[i]+w[i];auto s0=rotate(a,2)^rotate(a,13)^rotate(a,22);auto maj=(a&b)^(a&c)^(b&c);auto t2=s0+maj;
+            z=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;}
+        h[0]+=a;h[1]+=b;h[2]+=c;h[3]+=d;h[4]+=e;h[5]+=f;h[6]+=g;h[7]+=z;
+    }
+    static const char* hex="0123456789abcdef";std::string result;result.reserve(64);
+    for(auto word:h)for(int i=7;i>=0;--i)result.push_back(hex[(word>>(i*4))&15]);
+    return result;
+}
+nlohmann::json deferred_original_input() {
+    if(context().phase!=4) stop("original_input_reload_before_bcp_return");
+    const char* path=std::getenv("MS58_DIAGNOSTIC_NATIVE_INPUT_PATH");
+    const char* expected=std::getenv("UPSTREAM_NATIVE_INPUT_SHA256");
+    if(!path||!expected)stop("native_input_binding_missing");
+    std::ifstream file(path,std::ios::binary);if(!file)stop("native_input_reload_failed");
+    const std::string bytes((std::istreambuf_iterator<char>(file)),std::istreambuf_iterator<char>());
+    if(file.bad()||sha256_bytes(bytes)!=expected)stop("native_input_sha256_mismatch");
+    return nlohmann::json::parse(bytes);
+}
+}}
diff --git a/code/goc/src/math/pwl_diagnostic.cpp b/code/goc/src/math/pwl_diagnostic.cpp
new file mode 100644
index 0000000..44f934f
--- /dev/null
+++ b/code/goc/src/math/pwl_diagnostic.cpp
@@ -0,0 +1,70 @@
+#include "goc/math/pwl_diagnostic.h"
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <fstream>
+#include <iterator>
+#include <vector>
+#include <unistd.h>
+namespace goc { namespace pwl_diag {
+Context& context() { static Context value{}; return value; }
+std::uint64_t bits(double value) { std::uint64_t result; static_assert(sizeof(result)==sizeof(value), "binary64 required"); std::memcpy(&result, &value, sizeof(value)); return result; }
+nlohmann::json function_record(const PWLFunction& f) {
+    auto interval = [](const Interval& x) { return nlohmann::json::array({bits(x.left), bits(x.right)}); };
+    nlohmann::json pieces = nlohmann::json::array();
+    for (const auto& p : f.Pieces()) pieces.push_back({{"domain_bits", interval(p.domain)}, {"image_bits", interval(p.image)},
+        {"slope_bits", bits(p.slope)}, {"intercept_bits", bits(p.intercept)}});
+    return {{"encoding", "f2-legacy-scalar-binary64-uint64"}, {"cached_domain_bits", interval(f.Domain())},
+            {"cached_image_bits", interval(f.Image())}, {"piece_count", f.PieceCount()}, {"pieces", pieces}};
+}
+nlohmann::json identity_record() {
+    nlohmann::json identity = {{"base_source", "f2c9e205bd1ecc9afb45d5efe7fcb0df881f2b33"}};
+    for (const char* key : {"PROBE_MANIFEST_HASH", "PROBE_RUN_ID", "UPSTREAM_NATIVE_INPUT_SHA256", "MS58_DIAGNOSTIC_RAW_INPUT_SHA256", "MS58_DIAGNOSTIC_SOURCE_INVENTORY_SHA256"}) {
+        const char* value = std::getenv(key); identity[key] = value ? nlohmann::json(value) : nlohmann::json(nullptr);
+    }
+    const char* path=std::getenv("MS58_DIAGNOSTIC_NATIVE_INPUT_PATH");
+    identity["MS58_DIAGNOSTIC_NATIVE_INPUT_PATH"]=path?nlohmann::json(path):nlohmann::json(nullptr);
+    return identity;
+}
+void write_exclusive(const nlohmann::json& record) {
+    const char* path = std::getenv("MS58_DIAGNOSTIC_CAPTURE_PATH");
+    if (!path || !*path) throw Error(87, "capture_path_missing");
+    const std::string body = "{\"record\":" + record.dump() + ",\"complete\":true}\n";
+    const int fd = ::open(path, O_CREAT | O_EXCL | O_WRONLY, 0600);
+    if (fd < 0) throw Error(87, "exclusive_capture_open_failed");
+    std::size_t offset = 0;
+    while (offset < body.size()) {
+        const auto count = ::write(fd, body.data()+offset, body.size()-offset);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) { ::close(fd); throw Error(87, "capture_write_failed"); }
+        offset += static_cast<std::size_t>(count);
+    }
+    const bool flushed = ::fsync(fd) == 0;
+    const bool closed = ::close(fd) == 0;
+    if (!flushed || !closed) throw Error(87, "capture_flush_failed");
+}
+void require_bindings() {
+    for (const char* key : {"PROBE_MANIFEST_HASH", "PROBE_RUN_ID", "UPSTREAM_NATIVE_INPUT_SHA256", "MS58_DIAGNOSTIC_RAW_INPUT_SHA256", "MS58_DIAGNOSTIC_SOURCE_INVENTORY_SHA256"}) {
+        const char* value = std::getenv(key);
+        if (!value || std::strlen(value)!=64) throw Error(87, "identity_binding_missing");
+        for (const char* p=value; *p; ++p) if (!((*p>='0'&&*p<='9')||(*p>='a'&&*p<='f'))) throw Error(87, "identity_binding_invalid");
+    }
+    if (!std::getenv("MS58_DIAGNOSTIC_NATIVE_INPUT_PATH")) throw Error(87, "native_input_path_missing");
+    if (!std::getenv("MS58_DIAGNOSTIC_CAPTURE_PATH")) throw Error(87, "capture_path_missing");
+}
+[[noreturn]] void stop(const char* reason) {
+    write_exclusive({{"schema", "ms58-f2-terminal-pricing/v1"}, {"kind", "capture_failure"},
+        {"reason", reason}, {"identity", identity_record()}, {"phase", context().phase},
+        {"call_ordinal", context().call}, {"callback_generation", context().generation}});
+    throw Error(87, reason);
+}
+[[noreturn]] void invalid_compose(const PWLFunction& f, const PWLFunction& g, int i, int j, const char* site) {
+    write_exclusive({{"schema", "ms58-f2-terminal-pricing/v1"}, {"kind", "invalid_compose"},
+        {"site", site}, {"outer_index", i}, {"inner_piece_index", j}, {"outer_piece_count", f.PieceCount()},
+        {"inner_piece_count", g.PieceCount()}, {"outer", function_record(f)}, {"inner", function_record(g)},
+        {"identity", identity_record()}, {"phase", context().phase}, {"call_ordinal", context().call},
+        {"callback_generation", context().generation}});
+    throw Error(86, "invalid_compose_index");
+}
+}}
