diff --git a/code/include/diagnostic_capture.h b/code/include/diagnostic_capture.h
new file mode 100644
index 0000000..e190ffe
--- /dev/null
+++ b/code/include/diagnostic_capture.h
@@ -0,0 +1,74 @@
+#ifndef MS58_DIAGNOSTIC_CAPTURE_H
+#define MS58_DIAGNOSTIC_CAPTURE_H
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+#include <vector>
+#include <bitset>
+#include "goc/math/pwl_diagnostic.h"
+namespace networks2019 {
+constexpr int DiagnosticMaxVertices = 102;
+constexpr int DiagnosticMaxCuts = 500;
+struct DiagnosticEntry {
+    std::uint64_t call_ordinal, callback_generation;
+    int level, merge_start, solution_limit, process_limit[2], returned_status;
+    bool closing_state, partial, relax_elementary_check, relax_cost_check;
+    bool limited_extension, lazy_extension, unreachable_strengthened, sort_by_cost, correcting, symmetric;
+    bool cross[2], returned, finished;
+    std::size_t route_count, source_iteration_index, pool_bucket_count;
+    double time_budget_seconds, time_budget_milliseconds, callback_budget_milliseconds, initial_middle[2], pool_max_load_factor;
+};
+struct DiagnosticRaw {
+    std::uint64_t generation;
+    int vertex_count, cut_count, row_count, node_count;
+    std::size_t length;
+    double duals[DiagnosticMaxVertices + DiagnosticMaxCuts];
+};
+struct DiagnosticCapture {
+    DiagnosticRaw raw{};
+    DiagnosticEntry entry{};
+    std::uint64_t call_count = 0;
+    void snapshot_raw(const double* values, std::size_t count, int vertices, int cuts, int rows, int nodes) {
+        if (vertices < 2 || vertices > DiagnosticMaxVertices || cuts < 0 || cuts > DiagnosticMaxCuts ||
+            count != static_cast<std::size_t>(vertices+cuts) || rows != vertices+cuts)
+            goc::pwl_diag::stop("raw_dual_snapshot_bounds_or_rows");
+        ++raw.generation;
+        raw.vertex_count=vertices; raw.cut_count=cuts; raw.row_count=rows; raw.node_count=nodes; raw.length=count;
+        for (std::size_t i=0; i<count; ++i) raw.duals[i]=values[i];
+        goc::pwl_diag::context().generation=raw.generation;
+    }
+    void enter(DiagnosticEntry value) {
+        value.call_ordinal=++call_count; value.callback_generation=raw.generation; value.returned=false;
+        value.finished=false; value.route_count=0; entry=value;
+        goc::pwl_diag::context()={3, entry.call_ordinal, raw.generation};
+    }
+    void leave(int status, bool finished, std::size_t count) {
+        entry.returned_status=status; entry.finished=finished; entry.route_count=count; entry.returned=true;
+    }
+    const char* eligibility(bool bcp_returned, bool root_optimum, int nodes, bool forbidden_empty) const {
+        if (!bcp_returned) return "bcp_has_not_returned";
+        if (!root_optimum || nodes!=1 || raw.node_count!=1) return "not_completed_root_only";
+        if (!forbidden_empty) return "forbidden_arcs_present";
+        if (!entry.returned || entry.level!=2 || !entry.finished || entry.route_count!=0) return "last_call_not_exact_finished_empty";
+        if (entry.callback_generation!=raw.generation) return "raw_dual_generation_mismatch";
+        return nullptr;
+    }
+};
+static_assert(std::is_trivially_copyable<DiagnosticEntry>::value, "POD entry required");
+static_assert(std::is_trivially_copyable<DiagnosticRaw>::value, "POD raw snapshot required");
+DiagnosticCapture& diagnostic_capture();
+class BidirectionalLabeling;
+class PricingProblem;
+class SPF;
+struct DiagnosticAccess {
+    static DiagnosticEntry entry(const BidirectionalLabeling& lbl, int level, std::size_t iteration, double callback_budget_ms);
+    static nlohmann::json instances(const BidirectionalLabeling& lbl);
+    static const PricingProblem& problem(const BidirectionalLabeling& lbl);
+};
+int diagnostic_checked_vertex(int id, int n);
+double diagnostic_customer_duals(const std::vector<int>& path, const DiagnosticRaw& raw);
+nlohmann::json diagnostic_raw_query(const DiagnosticRaw& raw, const std::vector<std::bitset<102>>& cuts, const PricingProblem& query);
+void diagnostic_terminal(const BidirectionalLabeling& lbl, const SPF& spf, bool root_optimum, int nodes,
+    const nlohmann::json& final_log, const nlohmann::json& root_log, const nlohmann::json& witness, const nlohmann::json& original, const nlohmann::json& experiment, const nlohmann::json& effective_settings);
+}
+#endif
