@@ -0,0 +1,105 @@
+"""Compile and run only deterministic numerical and capture-state synthetic gates."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import resource
+import shutil
+import subprocess
+
+MODES = {'numeric-disjoint':86,'numeric-empty':86,'numeric-empty-decreasing':86,
+    'numeric-valid-overlap':0,'numeric-valid-increasing':0,'numeric-valid-decreasing':0,
+    'input-vectors':0,'input-reload':0,'input-before-return':87,'input-hash-mismatch':87,
+    'sequence':0,'invalid-vertex':87,'raw-overflow':87,'filter-mismatch':87}
+
+
+def sha(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def load_envelope(path):
+    value=json.loads(path.read_bytes())
+    if value.get('complete') is not True or not isinstance(value.get('record'),dict):
+        raise ValueError('Missing complete capture envelope')
+    if value['record'].get('schema')!='ms58-f2-terminal-pricing/v1':
+        raise ValueError('Unknown capture schema')
+    return value['record']
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output',type=Path,required=True)
+    parser.add_argument('--compiler',default='c++')
+    parser.add_argument('--reference-goc',type=Path,required=True)
+    parser.add_argument('--cplex-include',type=Path,default=Path.home()/'cplex1210/cplex/include')
+    args=parser.parse_args()
+    resource.setrlimit(resource.RLIMIT_CORE,(0,0))
+    source=Path(__file__).resolve().parents[1]
+    output=args.output.resolve();output.mkdir(parents=True,exist_ok=False)
+    compiler=Path(shutil.which(args.compiler) or args.compiler).resolve()
+    units=['diagnostic/tests/native_fixture.cpp','code/src/diagnostic_capture.cpp','code/src/bcp/pricing_problem.cpp',
+        'code/goc/src/math/pwl_diagnostic.cpp','code/goc/src/math/diagnostic_input.cpp','code/goc/src/math/pwl_function.cpp','code/goc/src/math/linear_function.cpp',
+        'code/goc/src/math/point_2d.cpp','code/goc/src/math/interval.cpp','code/goc/src/print/printable.cpp','code/goc/src/graph/arc.cpp']
+    binary=output/'native-fixture'
+    command=[str(compiler),'-std=c++14','-O0','-g','-D_GLIBCXX_ASSERTIONS','-ffp-contract=off','-ffunction-sections','-fdata-sections',
+        '-I'+str(source/'code/include'),'-I'+str(source/'code/goc/include'),'-I'+str(args.cplex_include),
+        *[str(source/p) for p in units],'-Wl,--gc-sections','-o',str(binary)]
+    (output/'plan.json').write_text(json.dumps(dict(command=command,compiler_sha256=sha(compiler),
+        units={p:sha(source/p) for p in units},schema_sha256=sha(source/'diagnostic/SCHEMA.json'),routing_runs=0),indent=2)+'\n')
+    with (output/'compile.stdout').open('x') as out,(output/'compile.stderr').open('x') as err:
+        code=subprocess.run(command,stdout=out,stderr=err,timeout=180).returncode
+    rows=[]
+    sample=output/'synthetic-native-input.json'
+    sample.write_text(json.dumps({'instance_name':'C104_100','synthetic_data':'a'*1000})+'\n')
+    if code==0:
+        for mode,expected in MODES.items():
+            artifact=output/(mode+'.json')
+            env=dict(os.environ,MS58_DIAGNOSTIC_CAPTURE_PATH=str(artifact))
+            for key in ('PROBE_MANIFEST_HASH','PROBE_RUN_ID','UPSTREAM_NATIVE_INPUT_SHA256','MS58_DIAGNOSTIC_RAW_INPUT_SHA256','MS58_DIAGNOSTIC_SOURCE_INVENTORY_SHA256'):env[key]='0'*64
+            env['MS58_DIAGNOSTIC_NATIVE_INPUT_PATH']=str(sample)
+            env['UPSTREAM_NATIVE_INPUT_SHA256']='0'*64 if mode=='input-hash-mismatch' else sha(sample)
+            with (output/(mode+'.stdout')).open('x') as out,(output/(mode+'.stderr')).open('x') as err:
+                observed=subprocess.run([str(binary),mode],env=env,stdout=out,stderr=err,timeout=30).returncode
+            valid=observed==expected
+            record=load_envelope(artifact) if artifact.exists() else None
+            if expected==86:
+                valid &= record is not None and record['kind']=='invalid_compose' and record['outer_index']>=record['outer_piece_count']
+            elif expected==87: valid &= record is not None and record['kind']=='capture_failure'
+            elif mode=='sequence':valid &= record is not None and record['valid_path_diagnostic_allocations']==0
+            else:valid &= not artifact.exists()
+            rows.append(dict(mode=mode,expected=expected,returncode=observed,passed=bool(valid),
+                artifact_sha256=sha(artifact) if artifact.exists() else None))
+        # Compare the complete binary64 function fields with the original f2 math implementation.
+        reference=args.reference_goc.resolve(); reference_binary=output/'original-f2-valid'
+        reference_units=['math/pwl_function.cpp','math/linear_function.cpp','math/point_2d.cpp','math/interval.cpp','print/printable.cpp']
+        ref_command=[str(compiler),'-std=c++14','-O0','-g','-D_GLIBCXX_ASSERTIONS','-ffp-contract=off',
+            '-I'+str(reference/'include'),str(source/'diagnostic/tests/reference_valid.cpp'),
+            *[str(reference/'src'/p) for p in reference_units],'-o',str(reference_binary)]
+        with (output/'reference-compile.stdout').open('x') as out,(output/'reference-compile.stderr').open('x') as err:
+            ref_code=subprocess.run(ref_command,stdout=out,stderr=err,timeout=180).returncode
+        rows.append(dict(mode='reference-compile',passed=ref_code==0,returncode=ref_code,
+            command=ref_command,source_files={p:sha(reference/'src'/p) for p in reference_units}))
+        if ref_code==0:
+            for mode in ('numeric-valid-overlap','numeric-valid-increasing','numeric-valid-decreasing'):
+                with (output/(mode+'-reference.stdout')).open('x') as out,(output/(mode+'-reference.stderr')).open('x') as err:
+                    ref_run=subprocess.run([str(reference_binary),mode],stdout=out,stderr=err,timeout=30).returncode
+                original=json.loads((output/(mode+'-reference.stdout')).read_bytes())
+                observed=json.loads((output/(mode+'.stdout')).read_bytes())
+                rows.append(dict(mode=mode+'-original-bitwise-equality',passed=ref_run==0 and observed==original))
+        # Exclusive publication must retain the first complete artifact and fail a second create.
+        existing=output/'sequence.json';before=sha(existing)
+        with (output/'exclusive.stdout').open('x') as out,(output/'exclusive.stderr').open('x') as err:
+            repeated=subprocess.run([str(binary),'numeric-disjoint'],env=dict(env,MS58_DIAGNOSTIC_CAPTURE_PATH=str(existing)),stdout=out,stderr=err,timeout=30).returncode
+        rows.append(dict(mode='exclusive-publication',passed=repeated==87 and sha(existing)==before,returncode=repeated))
+        for index,body in enumerate(('{"record":', '{"record":{"schema":"ms58-f2-terminal-pricing/v1"},"complete":false}')):
+            partial=output/('partial-'+str(index)+'.json');partial.write_text(body)
+            try:load_envelope(partial)
+            except (ValueError,json.JSONDecodeError):accepted=False
+            else:accepted=True
+            rows.append(dict(mode='reject-partial-'+str(index),passed=not accepted))
+    result=dict(compile_returncode=code,rows=rows,all_checks_passed=code==0 and len(rows)==21 and all(r['passed'] for r in rows),
+        routing_runs=0,source_replay_implemented=False,cross_engine_replay_implemented=False,
+        qualification='Synthetic numerical/capture-state gates only. Routing reachability, recorded-work parity and terminal capture on C104 remain untested.')
+    (output/'complete.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps(result,indent=2))
+    return int(not result['all_checks_passed'])
+
+if __name__=='__main__':raise SystemExit(main())
