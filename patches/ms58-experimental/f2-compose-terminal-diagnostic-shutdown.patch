@@ -0,0 +1,221 @@
+{
+  "schema": "ms58-f2-terminal-pricing/v1",
+  "status": "authoritative field contract for initial capture only; replay not implemented",
+  "publication": {
+    "envelope": {
+      "record": "object described below",
+      "complete": true
+    },
+    "exclusive_create": true,
+    "complete_marker_written_last": true,
