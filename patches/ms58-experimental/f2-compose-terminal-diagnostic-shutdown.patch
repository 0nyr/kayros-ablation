@@ -0,0 +1,92 @@
+#include "diagnostic_capture.h"
+#include "bcp/pricing_problem.h"
+#include <cassert>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <stdexcept>
+#include <unistd.h>
+using namespace networks2019;
+using goc::PWLFunction;
+static bool watch_allocations=false;
+static std::size_t allocations=0;
+void* operator new(std::size_t n) { if(watch_allocations) ++allocations; if(void* p=std::malloc(n))return p; throw std::bad_alloc(); }
+void operator delete(void* p) noexcept {std::free(p);}
+void operator delete(void* p,std::size_t) noexcept {std::free(p);}
+void* operator new[](std::size_t n) {return ::operator new(n);}
+void operator delete[](void* p) noexcept {std::free(p);}
+static void require(bool condition,const char* text) {if(!condition)throw std::runtime_error(text);}
+int main(int argc,char** argv) {
+    if(argc!=2)return 2;
+    try {
+        const std::string mode=argv[1];
+        if(mode=="input-vectors") {
+            require(goc::pwl_diag::sha256_bytes("")=="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","empty hash vector");
+            require(goc::pwl_diag::sha256_bytes("abc")=="ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad","abc hash vector");
+            std::cout<<"PASS hash vectors"<<std::endl;return 0;
+        }
+        if(mode=="input-reload"||mode=="input-before-return"||mode=="input-hash-mismatch") {
+            goc::pwl_diag::context().phase=mode=="input-before-return"?3:4;
+            const auto original=goc::pwl_diag::deferred_original_input();
+            require(original["instance_name"]=="C104_100","deferred native input changed");
+            std::cout<<"PASS deferred verified input"<<std::endl;return 0;
+        }
+        if(mode.find("numeric-")==0) {
+            const bool empty=mode=="numeric-empty"||mode=="numeric-empty-decreasing";
+            auto f=empty?PWLFunction():PWLFunction::ConstantFunction(0.0,{0,1});
+            auto g=mode=="numeric-disjoint"?PWLFunction::ConstantFunction(2.0,{0,1}):
+                mode=="numeric-valid-increasing"?PWLFunction({goc::LinearFunction({0,0},{2,1})}):
+                mode=="numeric-empty-decreasing"||mode=="numeric-valid-decreasing"?
+                    PWLFunction({goc::LinearFunction({0,1},{1,0})}):PWLFunction::ConstantFunction(0.5,{0,1});
+            auto result=f.Compose(g);
+            require(!empty&&mode!="numeric-disjoint","invalid composition returned replacement mathematics");
+            require(result.PieceCount()==1,"wrong piece count");
+            const double right=mode=="numeric-valid-increasing"?2:1;
+            require(result.Domain().left==0&&result.Domain().right==right,"wrong domain");
+            for(double x:{0.0,right/2,right})require(goc::pwl_diag::bits(result(x))==goc::pwl_diag::bits(0.0),"valid output bit mismatch");
+            std::cout<<goc::pwl_diag::function_record(result)<<std::endl;
+            return 0;
+        }
+        const double values[]={17,1,2,3,4,-19,1e-6,2e-5};
+        DiagnosticCapture capture;
+        capture.snapshot_raw(values,7,6,1,7,1);
+        DiagnosticEntry entry{}; entry.level=2; entry.closing_state=true; entry.merge_start=123;
+        entry.correcting=false;entry.lazy_extension=true;entry.solution_limit=3000;
+        capture.enter(entry);capture.leave(3,true,0);
+        entry.closing_state=false;entry.merge_start=0;
+        require(capture.entry.closing_state&&capture.entry.merge_start==123,"entry lost to callback resets");
+        require(capture.eligibility(false,true,1,true)!=nullptr,"early capture before BCP return");
+        require(::access(std::getenv("MS58_DIAGNOSTIC_CAPTURE_PATH"),F_OK)!=0,"early artifact emitted");
+        capture.snapshot_raw(values,8,6,2,8,1);
+        require(std::string(capture.eligibility(true,true,1,true))=="raw_dual_generation_mismatch","generation mismatch accepted");
+        entry.level=0;capture.enter(entry);capture.leave(3,true,1);
+        require(capture.eligibility(true,true,1,true)!=nullptr,"heuristic call accepted");
+        entry.level=2;capture.enter(entry);capture.leave(3,true,0);
+        require(capture.eligibility(true,true,1,true)==nullptr,"final Exact empty rejected");
+        require(capture.eligibility(true,true,2,true)!=nullptr,"nonroot accepted");
+        require(capture.eligibility(true,true,1,false)!=nullptr,"forbidden arcs accepted");
+        if(mode=="invalid-vertex") { diagnostic_customer_duals({0,6,5},capture.raw);return 99; }
+        if(mode=="raw-overflow") { capture.snapshot_raw(nullptr,603,102,501,603,1);return 99; }
+        require(diagnostic_customer_duals({0,1,2,5},capture.raw)==3.0,"depot dual included in route coefficient");
+        auto f=PWLFunction::ConstantFunction(0,{0,1});auto g=PWLFunction::ConstantFunction(0.5,{0,1});
+        allocations=0;watch_allocations=true;
+        for(int i=0;i<10000;++i) {
+            goc::pwl_diag::checked_piece(f,g,0,0,"synthetic_valid");
+            capture.snapshot_raw(values,8,6,2,8,1);capture.enter(entry);capture.leave(3,true,0);
+        }
+        watch_allocations=false;require(allocations==0,"diagnostic allocated on valid scalar path");
+        std::bitset<102> a,b;for(int i:{1,2,3})a.set(i);for(int i:{2,3,4})b.set(i);
+        PricingProblem query;query.P.assign(values,values+6);query.S={b};query.sigma={2e-5};
+        auto record=diagnostic_raw_query(capture.raw,{a,b},query);
+        require(record["raw_master"]["dual_bits"][6]==goc::pwl_diag::bits(1e-6),"small raw cut dual lost");
+        require(record["native_query"]["raw_cut_indices"]==nlohmann::json::array({1}),"wrong f2 filter");
+        if(mode=="filter-mismatch") {query.S={a,b};query.sigma={1e-6,2e-5};diagnostic_raw_query(capture.raw,{a,b},query);return 99;}
+        require(mode=="sequence","unknown mode");
+        record["schema"]="ms58-f2-terminal-pricing/v1";record["kind"]="synthetic_context_gate";
