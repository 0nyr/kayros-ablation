diff --git a/code/src/diagnostic_capture.cpp b/code/src/diagnostic_capture.cpp
new file mode 100644
index 0000000..a52029d
--- /dev/null
+++ b/code/src/diagnostic_capture.cpp
@@ -0,0 +1,144 @@
+#include "diagnostic_capture.h"
+#include "labeling/bidirectional_labeling.h"
+#include "bcp/spf.h"
+#include "bcp/pricing_problem.h"
+#include "goc/math/number_utils.h"
+namespace networks2019 {
+using nlohmann::json;
+using goc::pwl_diag::bits;
+DiagnosticCapture& diagnostic_capture() { static DiagnosticCapture value; return value; }
+int diagnostic_checked_vertex(int id, int n) {
+    if (n < 2 || n > DiagnosticMaxVertices || id < 0 || id >= n) goc::pwl_diag::stop("invalid_vertex_before_indexing");
+    return id;
+}
+double diagnostic_customer_duals(const std::vector<int>& path, const DiagnosticRaw& raw) {
+    double result=0.0;
+    for (int id : path) {
+        diagnostic_checked_vertex(id, raw.vertex_count);
+        if (id!=0 && id!=raw.vertex_count-1) result+=raw.duals[id];
+    }
+    return result;
+}
+namespace {
+json cut_record(const std::bitset<102>& cut, int n) {
+    json values=json::array();
+    for (int i=0; i<102; ++i) if (cut.test(i)) {
+        diagnostic_checked_vertex(i,n);
+        if (i==0 || i==n-1) goc::pwl_diag::stop("depot_in_subset_row_cut");
+        values.push_back(i);
+    }
+    if (values.size()!=3) goc::pwl_diag::stop("non_triple_subset_row_cut");
+    return values;
+}
+json arcs_record(const std::vector<goc::Arc>& arcs, int n) {
+    json result=json::array();
+    for (auto arc : arcs) result.push_back({diagnostic_checked_vertex(arc.tail,n),diagnostic_checked_vertex(arc.head,n)});
+    return result;
+}
+json instance_record(const VRPInstance& v) {
+    const int n=v.D.VertexCount();
+    if (n<2 || n>102 || v.tw.size()!=static_cast<std::size_t>(n) || v.q.size()!=static_cast<std::size_t>(n))
+        goc::pwl_diag::stop("instance_dimension_mismatch");
+    json successors=json::array(), predecessors=json::array(), windows=json::array(), demands=json::array();
+    for (int i=0; i<n; ++i) {
+        for (int id : v.D.Successors(i)) diagnostic_checked_vertex(id,n);
+        for (int id : v.D.Predecessors(i)) diagnostic_checked_vertex(id,n);
+        successors.push_back(v.D.Successors(i)); predecessors.push_back(v.D.Predecessors(i));
+        windows.push_back({bits(v.tw[i].left),bits(v.tw[i].right)}); demands.push_back(bits(v.q[i]));
+    }
+    auto functions = [&](const goc::Matrix<goc::PWLFunction>& matrix) {
+        if (matrix.row_count()!=n || matrix.column_count()!=n) goc::pwl_diag::stop("function_matrix_dimension_mismatch");
+        json rows=json::array();
+        for (int i=0;i<n;++i) { json row=json::array(); for (int j=0;j<n;++j) row.push_back(goc::pwl_diag::function_record(matrix[i][j])); rows.push_back(row); }
+        return rows;
+    };
+    if (v.LDT.row_count()!=n || v.LDT.column_count()!=n) goc::pwl_diag::stop("ldt_dimension_mismatch");
+    json ldt=json::array();
+    for (int i=0;i<n;++i) { json row=json::array(); for (int j=0;j<n;++j) row.push_back(bits(v.LDT[i][j])); ldt.push_back(row); }
+    return {{"vertex_count",n},{"origin",diagnostic_checked_vertex(v.o,n)},{"destination",diagnostic_checked_vertex(v.d,n)},
+        {"horizon_bits",bits(v.T)},{"capacity_bits",bits(v.Q)},{"windows_bits",windows},{"demands_bits",demands},
+        {"graph",{{"successors",successors},{"predecessors",predecessors},{"ordered_arcs",arcs_record(v.D.Arcs(),n)}}},
+        {"tau",functions(v.tau)},{"arr",functions(v.arr)},{"dep",functions(v.dep)},{"pretau",functions(v.pretau)},{"ldt_bits",ldt}};
+}
+json entry_record(const DiagnosticEntry& e) {
+    return {{"call_ordinal",e.call_ordinal},{"callback_generation",e.callback_generation},{"level",e.level},
+        {"closing_state",e.closing_state},{"merge_start",e.merge_start},{"solution_limit",e.solution_limit},
+        {"partial",e.partial},{"relax_elementary_check",e.relax_elementary_check},{"relax_cost_check",e.relax_cost_check},
+        {"limited_extension",e.limited_extension},{"lazy_extension",e.lazy_extension},{"unreachable_strengthened",e.unreachable_strengthened},
+        {"sort_by_cost",e.sort_by_cost},{"correcting",e.correcting},{"symmetric",e.symmetric},
+        {"process_limits",{e.process_limit[0],e.process_limit[1]}},{"cross",{e.cross[0],e.cross[1]}},
+        {"time_budget_seconds_bits",bits(e.time_budget_seconds)},{"time_budget_milliseconds_bits",bits(e.time_budget_milliseconds)},{"callback_budget_milliseconds_bits",bits(e.callback_budget_milliseconds)},{"initial_middle_bits",{bits(e.initial_middle[0]),bits(e.initial_middle[1])}},
+        {"pool_bucket_count",e.pool_bucket_count},{"pool_max_load_factor_bits",bits(e.pool_max_load_factor)},
+        {"returned_status",e.returned_status},{"finished",e.finished},{"route_count",e.route_count},{"source_iteration_index",e.source_iteration_index}};
+}
+}
+json diagnostic_raw_query(const DiagnosticRaw& raw, const std::vector<std::bitset<102>>& cuts, const PricingProblem& query) {
+    if (raw.vertex_count<2 || raw.vertex_count>102 || raw.cut_count<0 || raw.cut_count>500 || raw.length>602 || cuts.size()!=static_cast<std::size_t>(raw.cut_count) ||
+        raw.length!=static_cast<std::size_t>(raw.vertex_count+raw.cut_count) || raw.row_count!=static_cast<int>(raw.length) ||
+        query.P.size()!=static_cast<std::size_t>(raw.vertex_count) || query.S.size()!=query.sigma.size())
+        goc::pwl_diag::stop("terminal_raw_query_shape_mismatch");
+    json duals=json::array(), profits=json::array(), ordered=json::array(), filtered=json::array(), sigma=json::array(), indices=json::array();
+    for (std::size_t i=0;i<raw.length;++i) duals.push_back(bits(raw.duals[i]));
+    for (int i=0;i<raw.vertex_count;++i) {
+        if (bits(query.P[i])!=bits(raw.duals[i])) goc::pwl_diag::stop("terminal_profit_bits_mismatch");
+        profits.push_back(bits(query.P[i]));
+    }
+    std::size_t k=0;
+    for (std::size_t i=0;i<cuts.size();++i) {
+        auto vertices=cut_record(cuts[i],raw.vertex_count); ordered.push_back(vertices);
+        const double dual=raw.duals[raw.vertex_count+i];
+        if (goc::epsilon_different(dual,0.0)) {
+            if (k>=query.S.size() || cuts[i]!=query.S[k] || bits(dual)!=bits(query.sigma[k]))
+                goc::pwl_diag::stop("terminal_filtered_context_mismatch");
+            filtered.push_back(vertices); sigma.push_back(bits(query.sigma[k])); indices.push_back(i); ++k;
+        }
+    }
+    if (k!=query.S.size()) goc::pwl_diag::stop("terminal_filtered_context_extra_cut");
+    return {{"raw_master",{{"callback_generation",raw.generation},{"pricing_node_count",raw.node_count},{"vertex_row_count",raw.vertex_count},
+        {"cut_count",raw.cut_count},{"row_count",raw.row_count},{"dual_bits",duals},{"ordered_cuts",ordered},
+        {"dual_semantics","duals_passed_to_terminal_pricing_not_postsolve_duals"},{"depot_route_coefficients",{0,0}}}},
+        {"native_query",{{"profit_bits",profits},{"forbidden_arcs",arcs_record(query.A,raw.vertex_count)},
+        {"filtered_cuts",filtered},{"filtered_sigma_bits",sigma},{"raw_cut_indices",indices},{"eps_bits",bits(goc::EPS)},
+        {"filter_predicate","fabs(dual)>=EPS"}}}};
+}
+DiagnosticEntry DiagnosticAccess::entry(const BidirectionalLabeling& l, int level, std::size_t iteration, double callback_budget_ms) {
+    DiagnosticEntry e{}; e.level=level; e.merge_start=l.merge_start; e.closing_state=l.closing_state;
+    e.solution_limit=l.solution_limit; e.partial=l.partial; e.relax_elementary_check=l.relax_elementary_check;
+    e.relax_cost_check=l.relax_cost_check; e.limited_extension=l.limited_extension; e.lazy_extension=l.lazy_extension;
+    e.unreachable_strengthened=l.unreachable_strengthened; e.sort_by_cost=l.sort_by_cost; e.correcting=l.correcting;
+    e.symmetric=l.symmetric; e.time_budget_seconds=l.time_limit.Amount(goc::DurationUnit::Seconds);
+    e.time_budget_milliseconds=l.time_limit.Amount(goc::DurationUnit::Milliseconds); e.callback_budget_milliseconds=callback_budget_ms;
+    e.source_iteration_index=iteration; e.pool_bucket_count=l.S.bucket_count(); e.pool_max_load_factor=l.S.max_load_factor();
+    for(int d=0;d<2;++d) {e.process_limit[d]=l.lbl_[d].process_limit; e.cross[d]=l.lbl_[d].cross; e.initial_middle[d]=l.symmetric?l.vrp_.T/2:l.vrp_.T;}
+    return e;
+}
+const PricingProblem& DiagnosticAccess::problem(const BidirectionalLabeling& l) { return l.pp_; }
+json DiagnosticAccess::instances(const BidirectionalLabeling& l) {
+    return {{"bidirectional",instance_record(l.vrp_)},{"forward",instance_record(l.lbl_[0].vrp_)},{"backward",instance_record(l.lbl_[1].vrp_)},
+        {"returned_pool_bucket_count",l.S.bucket_count()},{"returned_pool_max_load_factor_bits",bits(l.S.max_load_factor())}};
+}
+void diagnostic_terminal(const BidirectionalLabeling& lbl, const SPF& spf, bool root_optimum, int nodes,
+    const json& final_log, const json& root_log, const json& witness, const json& original, const json& experiment, const json& effective_settings) {
+    const auto& c=diagnostic_capture(); const auto& pp=DiagnosticAccess::problem(lbl);
+    const char* reason=c.eligibility(true,root_optimum,nodes,pp.A.empty());
+    if (!reason && original.value("instance_name",std::string())!="C104_100") reason="outside_initial_c104_root_scope";
+    json record={{"schema","ms58-f2-terminal-pricing/v1"},{"identity",goc::pwl_diag::identity_record()},
+        {"proof_acceptance","diagnostic_only_no_closure_credit"},{"source_bcp_log",final_log},{"effective_settings",effective_settings}};
+    if (reason) {record["kind"]="no_terminal_capture"; record["reason"]=reason; record["entry_policy"]=entry_record(c.entry); goc::pwl_diag::write_exclusive(record); return;}
+    if (spf.cuts.size()!=static_cast<std::size_t>(c.raw.cut_count) || spf.formulation->ConstraintCount()!=c.raw.row_count)
+        goc::pwl_diag::stop("terminal_generation_rows_or_cuts_changed");
+    if (!root_log.is_object() || !root_log.count("iterations") || c.entry.source_iteration_index+1!=root_log["iterations"].size() ||
+        root_log["iterations"][c.entry.source_iteration_index].value("iteration_name",std::string())!="Exact")
+        goc::pwl_diag::stop("terminal_source_iteration_mismatch");
+    const auto contexts=diagnostic_raw_query(c.raw,spf.cuts,pp);
+    record["kind"]="terminal_root_pricing"; record["processed_node_count"]=nodes; record["entry_policy"]=entry_record(c.entry);
+    record["raw_master"]=contexts["raw_master"]; record["native_query"]=contexts["native_query"];
+    record["labeling_instances"]=DiagnosticAccess::instances(lbl); record["source_root_cg_log"]=root_log;
+    record["source_final_pricing_iteration"]=root_log["iterations"][c.entry.source_iteration_index];
+    record["returned_witness"]=witness; record["terminal_returned_paths"]=json::array();
+    if (witness.is_object() && witness.count("value")) record["returned_witness"]["value_bits"]=bits(witness["value"].get<double>());
+    if (witness.is_object() && witness.count("routes")) for (auto& route : record["returned_witness"]["routes"]) { route["t0_bits"]=bits(route["t0"].get<double>()); route["duration_bits"]=bits(route["duration"].get<double>()); } record["original_instance"]=original; record["experiment"]=experiment;
+    record["source_returned_route_count"]=c.entry.route_count; record["serialization_phase"]="after_bcp_run_return";
+    goc::pwl_diag::write_exclusive(record);
+}
+}
