@@ -0,0 +1,29 @@
+#ifndef GOC_PWL_DIAGNOSTIC_H
+#define GOC_PWL_DIAGNOSTIC_H
+#include <cstdint>
+#include <exception>
+#include "goc/math/pwl_function.h"
+namespace goc { namespace pwl_diag {
+struct Error : std::exception {
+    int code;
+    const char* reason;
+    Error(int code, const char* reason) : code(code), reason(reason) {}
+    const char* what() const noexcept override { return reason; }
+};
+struct Context { int phase; std::uint64_t call, generation; };
+Context& context();
+std::uint64_t bits(double value);
+nlohmann::json function_record(const PWLFunction& f);
+nlohmann::json identity_record();
+void write_exclusive(const nlohmann::json& record);
+void require_bindings();
+std::string sha256_bytes(const std::string& bytes);
+nlohmann::json deferred_original_input();
+[[noreturn]] void stop(const char* reason);
+[[noreturn]] void invalid_compose(const PWLFunction& f, const PWLFunction& g, int i, int j, const char* site);
+inline const LinearFunction& checked_piece(const PWLFunction& f, const PWLFunction& g, int i, int j, const char* site) {
+    if (i < 0 || i >= f.PieceCount()) invalid_compose(f, g, i, j, site);
+    return f[i];
+}
+}}
+#endif
diff --git a/code/goc/src/math/diagnostic_input.cpp b/code/goc/src/math/diagnostic_input.cpp
