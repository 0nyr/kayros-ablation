+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        std::filesystem::remove_all(root);
+        return 1;
+    }
+}
diff --git a/tests/cpp/test_dominance_profile_pwl.cpp b/tests/cpp/test_dominance_profile_pwl.cpp
