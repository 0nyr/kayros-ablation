 void BidirectionalLabeling::RefreshCorrectedMergeLabels(int direction)
 {
 	auto& changed = lbl_[direction].corrected_merge_buckets_;
+#ifdef KAYROS_DOMINANCE_PROFILING
+	using DP = DominanceProfile;
+	using C = DP::Counter;
+	DP::Episode profile(lbl_[direction].dominance_profile_, DP::Kind::MergeMaintenance);
+	profile.Add(C::MergeDirty, changed.size());
+	size_t profile_removed = 0;
+#endif
+
 	if (!closing_state)
 	{
 		std::sort(changed.begin(), changed.end());
 		changed.erase(std::unique(changed.begin(), changed.end()), changed.end());
+#ifdef KAYROS_DOMINANCE_PROFILING
+		profile.Add(C::MergeUnique, changed.size());
+#endif
+
 		for (const auto& [vertex, demand] : changed)
 			for (auto& entry : M[direction][vertex])
 			{
+#ifdef KAYROS_DOMINANCE_PROFILING
+				profile.Add(C::MergeEntries);
+#endif
 				if (entry.first < demand) continue;
 				if (entry.first > demand) break;
 				auto& labels = entry.second;
+#ifdef KAYROS_DOMINANCE_PROFILING
+				profile.Add(C::MergeLabels, labels.size());
+				const auto profile_before = labels.size();
+#endif
+
 				labels.erase(std::remove_if(labels.begin(), labels.end(),
 					[](Label* label) { return label->duration.Empty(); }), labels.end());
+#ifdef KAYROS_DOMINANCE_PROFILING
+				profile.Add(C::MergeRetirements, profile_before - labels.size());
+				profile_removed += profile_before - labels.size();
+				profile.Add(C::MergeSorts);
+#endif
 				std::stable_sort(labels.begin(), labels.end(),
 					[](Label* a, Label* b) { return a->min_cost < b->min_cost; });
 				break;
 			}
 	}
 	changed.clear();
+#ifdef KAYROS_DOMINANCE_PROFILING
+	profile.Finish(profile_removed != 0);
+#endif
 }
 
