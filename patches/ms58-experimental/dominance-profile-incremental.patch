+#include "labeling/pwl_domination_function.h"
+
+#include <bit>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+using namespace goc;
+using namespace solver;
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+uint64_t digest = 1469598103934665603ULL;
+void record(double value) {
+    digest ^= std::bit_cast<uint64_t>(value);
+    digest *= 1099511628211ULL;
+}
+void record(const PWLFunction& function) {
+    record(function.PieceCount());
+    for (const auto& piece : function.Pieces()) {
+        record(piece.domain.left); record(piece.domain.right);
+        record(piece.image.left); record(piece.image.right);
+        record(piece.intercept); record(piece.slope);
+        record(piece.is_choice_vertical()); record(piece.is_jump_vertical());
+    }
+}
+void identical(const PWLFunction& left, const PWLFunction& right) {
+    require(left.PieceCount() == right.PieceCount(), "Instrumentation changed piece count");
+    for (int i = 0; i < left.PieceCount(); ++i) {
+        const auto& a = left.Piece(i);
+        const auto& b = right.Piece(i);
+        for (auto pair : {std::pair{a.domain.left, b.domain.left}, std::pair{a.domain.right, b.domain.right},
+                          std::pair{a.image.left, b.image.left}, std::pair{a.image.right, b.image.right},
+                          std::pair{a.intercept, b.intercept}, std::pair{a.slope, b.slope}})
+            require(std::bit_cast<uint64_t>(pair.first) == std::bit_cast<uint64_t>(pair.second),
+                    "Instrumentation changed a piece bit pattern");
+        require(a.is_choice_vertical() == b.is_choice_vertical() && a.is_jump_vertical() == b.is_jump_vertical(),
+                "Instrumentation changed a vertical kind");
+    }
+}
+
+std::vector<PWLFunction> functions() {
+    std::vector<PWLFunction> result;
+    result.push_back(PWLFunction());
+    for (double left : {0.0, 2.0}) {
+        for (double value : {-1.0, 0.0, 3.0}) {
+            result.push_back(PWLFunction::ConstantFunction(value, {left, left}));
+            result.push_back(PWLFunction::ConstantFunction(value, {left, 10.0}));
+            result.push_back(PWLFunction({LinearFunction({left, value}, {10.0, value + 5.0})}));
+        }
+    }
+    PWLFunction choice;
+    choice.AddPiece(LinearFunction({0.0, 3.0}, {0.0, 1.0}).as_choice_vertical());
+    choice.AddPiece(LinearFunction({0.0, 1.0}, {5.0, 2.0}));
+    choice.AddPiece(LinearFunction({5.0, 2.0}, {5.0, -1.0}).as_choice_vertical());
+    result.push_back(choice);
+    PWLFunction jump;
+    jump.AddPiece(LinearFunction({0.0, 1.0}, {3.0, 2.0}));
+    jump.AddPiece(LinearFunction({3.0, 2.0}, {3.0, 5.0}));
+    jump.AddPiece(LinearFunction({3.0, 5.0}, {8.0, 6.0}));
+    result.push_back(jump);
+    return result;
+}
+
+void check_mutation_fixtures() {
+#ifdef KAYROS_DOMINANCE_PROFILING
+    using C = DominanceProfile::Counter;
+    DominanceProfile::Counters counters;
+    const auto count = [&](C counter) { return counters.values[static_cast<size_t>(counter)]; };
+    PWLDominationFunction shrink(PWLFunction::ConstantFunction(1.0, {0.0, 10.0}));
+    shrink.SetProfile(&counters);
+    require(!shrink.DominatePieces(PWLFunction::ConstantFunction(0.0, {0.0, 3.0})), "Prefix removal should survive");
+    require(count(C::PartialShrinkLeft) == 2 && count(C::PartialErase) == 0,
+            "False partial result failed to record prefix mutation");
+    require(static_cast<PWLFunction>(shrink).Domain().left == 4.0, "Prefix fixture shape changed");
+    PWLDominationFunction split(PWLFunction::ConstantFunction(1.0, {0.0, 10.0}));
+    split.SetProfile(&counters);
+    require(!split.DominatePieces(PWLFunction::ConstantFunction(0.0, {3.0, 5.0})), "Interior removal should survive");
+    require(count(C::PartialSplit) == 1 && static_cast<PWLFunction>(split).PieceCount() == 2,
+            "False partial result failed to record a split");
+    PWLDominationFunction erase(PWLFunction::ConstantFunction(1.0, {0.0, 10.0}));
+    erase.SetProfile(&counters);
+    require(erase.DominatePieces(PWLFunction::ConstantFunction(0.0, {0.0, 10.0})), "Full removal should eliminate");
+    require(count(C::PartialErase) == 1 && erase.Empty(), "Erase count changed");
+    PWLDominationFunction full(PWLFunction::ConstantFunction(1.0, {0.0, 10.0}));
+    full.SetProfile(&counters);
+    require(full.IsAlwaysDominated(PWLFunction::ConstantFunction(0.0, {0.0, 10.0})), "Full predicate changed");
+    require(count(C::FullComparisons) > 0 && count(C::FullScalar) == count(C::FullComparisons),
+            "Full-only comparisons were not separate");
+    require(count(C::CompletionCalls) == 4 && count(C::CompletionPieces) >= 4,
+            "Completion accounting changed");
+#endif
+}
+}
+
+int main() {
+    try {
+        check_mutation_fixtures();
+        size_t cases = 0;
+        const auto inputs = functions();
+        for (bool exact : {false, true}) {
+            StepExactArithmeticScope arithmetic(exact);
+            for (const auto& left : inputs) for (const auto& right : inputs) {
+                if (right.Empty()) continue;
+                for (double delta : {-1.0, 0.0, 1.0}) {
+                    for (bool full : {false, true}) {
+                        PWLDominationFunction baseline(left), instrumented(left);
+#ifdef KAYROS_DOMINANCE_PROFILING
+                        DominanceProfile::Counters counters;
+                        instrumented.SetProfile(&counters);
+#endif
+                        const bool a = full ? baseline.IsAlwaysDominated(right, delta) : baseline.DominatePieces(right, delta);
+                        const bool b = full ? instrumented.IsAlwaysDominated(right, delta) : instrumented.DominatePieces(right, delta);
+                        require(a == b, "Instrumentation changed the predicate result");
+                        const auto expected = static_cast<PWLFunction>(baseline);
+                        const auto actual = static_cast<PWLFunction>(instrumented);
+                        identical(expected, actual);
+                        record(a); record(actual);
+                        ++cases;
+                    }
+                }
+            }
+        }
+        std::cout << "PASS native PWL bitwise cases=" << cases << " digest=" << std::hex << digest << '\n';
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
