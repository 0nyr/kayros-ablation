+++ b/tests/cpp/check_dominance_profile_off.py
@@ -0,0 +1,62 @@
+"""Check OFF preprocessing against exact selected9d without changing its tree."""
+from __future__ import annotations
+
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tarfile
+import tempfile
+
+BASE = "9d64b7c53ddaea7a578d247ebd28db43ae0d4e56"
+ROOT = Path(__file__).resolve().parents[2]
+SOURCES = [
+    "cpp/lera/main/src/labeling/monodirectional_labeling.cpp",
+    "cpp/lera/main/src/labeling/bidirectional_labeling.cpp",
+    "cpp/lera/main/src/labeling/pwl_domination_function.cpp",
+    "cpp/lera/main/include/labeling/bidirectional_labeling.h",
+    "cpp/lera/main/include/labeling/monodirectional_labeling.h",
+    "cpp/lera/main/include/labeling/pwl_domination_function.h",
+]
+# Keep quoted literals intact, including their internal whitespace. The input
+# has already been preprocessed, so comments and directives are absent.
+TOKEN = re.compile(
+    r'(?:u8|u|U|L)?R"(?P<delimiter>[^ ()\\\t\r\n]{0,16})\(.*?\)(?P=delimiter)"'
+    r'|(?:u8|u|U|L)?"(?:\\.|[^"\\])*"'
+    r"|(?:u8|u|U|L)?'(?:\\.|[^'\\])*'"
+    r'|[A-Za-z_$][A-Za-z_0-9$]*'
+    r'|(?:\d|\.\d)(?:[eEpP][+-]|[A-Za-z_0-9.])*'
+    r'|%:%:|<=>|>>=|<<=|->\*|\.\.\.|##|::|\.\*|->|\+\+|--|<<|>>|<=|>=|==|!='
+    r'|&&|\|\||\*=|/=|%=|\+=|-=|&=|\^=|\|=|<:|:>|<%|%>|%:|[^\s]',
+    re.DOTALL,
+)
+
+
+def tokens(tree: Path, source: str) -> bytes:
+    command = ["g++", "-std=c++23", "-E", "-P", "-w", "-x", "c++",
+               "-Icpp/lera/main/include", "-Icpp/lera/goc/include",
+               "-Icpp/lera/nyr/include", "-Icpp/lera/magic_enum/include"]
+    if os.environ.get("BOOST_INCLUDE"):
+        command += ["-isystem", os.environ["BOOST_INCLUDE"]]
+    command.append(source)
+    result = subprocess.run(command, cwd=tree, check=True, capture_output=True, text=True)
+    return "\0".join(match.group() for match in TOKEN.finditer(result.stdout)).encode()
+
+
+with tempfile.TemporaryDirectory(prefix="kayros-dominance-off-") as temporary:
+    base_tree = Path(temporary)
+    archive = subprocess.run(["git", "archive", BASE], cwd=ROOT, check=True, capture_output=True).stdout
+    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
+        tar.extractall(base_tree, filter="data")
+    results = []
+    for source in SOURCES:
+        original, derivative = tokens(base_tree, source), tokens(ROOT, source)
+        if original != derivative:
+            raise AssertionError(f"OFF preprocessing differs for {source}")
+        results.append({"source": source, "token_sha256": hashlib.sha256(original).hexdigest(),
+                        "token_bytes": len(original), "equivalent": True})
+    print(json.dumps({"base": BASE, "definition": "KAYROS_DOMINANCE_PROFILING absent",
+                      "checks": results}, indent=2))
