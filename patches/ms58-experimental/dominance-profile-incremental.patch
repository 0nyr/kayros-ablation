+namespace solver {
+class DominanceProfile {
+public:
+    using Clock = std::chrono::steady_clock;
+    using Json = nlohmann::json;
+    enum class Counter { CandidatePieces, CandidateDemandFloorSum, CandidateBuckets, DepotShortcut, Buckets, DemandBreak, Labels, CostBreak, SubsetTests, SubsetPass, SubsetReject, ThetaTerms, ThetaSubtractions, ScratchFunctions, ScratchPieces, PartialCalls, PartialTrue, PartialFalse, FullCalls, FullTrue, FullFalse, Materializations, Normalizations, CostChanges, Retirements, Sorts, MergeDirty, MergeUnique, MergeEntries, MergeLabels, MergeRetirements, MergeSorts, CompletionCalls, CompletionPieces, PartialEmpty, PartialBeforeDomain, PartialPointDomain, PartialPairIterations, PartialSkipDominatorBefore, PartialSkipCandidateBefore, PartialSkipCandidateEnd, PartialSkipDominatorEnd, PartialComparisons, PartialScalar, PartialChoice, PartialJump, PartialErase, PartialShrinkLeft, PartialShrinkRight, PartialSplit, FullEmpty, FullBeforeDomain, FullPairIterations, FullSearchPieces, FullGap, FullComparisons, FullScalar, FullChoice, FullJump, FullValueReject, Count };
+    enum class Kind { Dominance, Correction, MergeMaintenance };
+    enum class Stage { Construction, Scan, Materialization, Count };
+    struct Counters {
+        std::array<uint64_t, static_cast<size_t>(Counter::Count)> values{};
+        void Add(Counter c, uint64_t n = 1) { values[static_cast<size_t>(c)] += n; }
+    };
+    struct Outcome {
+        uint64_t finished = 0, sampled_finished = 0, sampled_ns = 0;
+        std::array<uint64_t, static_cast<size_t>(Stage::Count)> stage_ns{};
+        Counters counters;
+    };
+    struct Operation {
+        uint64_t attempts = 0, sampled_attempts = 0;
+        // Index 0 survives (or removes no existing label), index 1 eliminates.
+        std::array<Outcome, 2> outcomes{};
+    };
+    struct Direction {
+        std::array<Operation, 3> operations{};
+        DominanceProfile* owner = nullptr;
+    };
+private:
+    FILE* file_ = nullptr;
+    uint64_t stride_ = 1009, offset_ = 0, call_ = 0;
+    std::array<Direction, 2> directions_{};
+    bool active_ = false;
+    Clock::time_point started_{}, last_output_{};
+    static uint64_t Integer(const char* name, uint64_t fallback) {
+        const char* value = std::getenv(name);
+        if (!value) return fallback;
+        uint64_t result = 0;
+        const auto end = value + std::strlen(value);
+        const auto parsed = std::from_chars(value, end, result);
+        if (parsed.ec != std::errc{} || parsed.ptr != end)
+            throw std::runtime_error(std::string("Invalid dominance profile integer: ") + name);
+        return result;
+    }
+    static uint64_t Ns(Clock::duration value) {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(value).count();
+    }
+    static Json DirectionJson(const Direction& direction) {
+        static constexpr const char* counter_names[] = { "candidate_pieces", "candidate_demand_floor_sum", "candidate_buckets", "depot_shortcut", "buckets", "demand_break", "labels", "cost_break", "subset_tests", "subset_pass", "subset_reject", "theta_terms", "theta_subtractions", "scratch_functions", "scratch_pieces", "partial_calls", "partial_true", "partial_false", "full_calls", "full_true", "full_false", "materializations", "normalizations", "cost_changes", "retirements", "sorts", "merge_dirty", "merge_unique", "merge_entries", "merge_labels", "merge_retirements", "merge_sorts", "completion_calls", "completion_pieces", "partial_empty", "partial_before_domain", "partial_point_domain", "partial_pair_iterations", "partial_skip_dominator_before", "partial_skip_candidate_before", "partial_skip_candidate_end", "partial_skip_dominator_end", "partial_comparisons", "partial_scalar", "partial_choice", "partial_jump", "partial_erase", "partial_shrink_left", "partial_shrink_right", "partial_split", "full_empty", "full_before_domain", "full_pair_iterations", "full_search_pieces", "full_gap", "full_comparisons", "full_scalar", "full_choice", "full_jump", "full_value_reject" };
+        static constexpr const char* kind_names[] = {"dominance", "correction", "merge_maintenance"};
+        static constexpr const char* stage_names[] = {"construction", "scan", "materialization"};
+        static_assert(std::size(counter_names) == static_cast<size_t>(Counter::Count));
+        Json result = Json::object();
+        for (size_t k = 0; k < direction.operations.size(); ++k) {
+            const auto& operation = direction.operations[k];
+            Json entry = {{"attempts", operation.attempts}, {"sampled_attempts", operation.sampled_attempts}};
+            for (size_t o = 0; o < operation.outcomes.size(); ++o) {
+                const auto& outcome = operation.outcomes[o];
+                Json value = {{"finished", outcome.finished}, {"sampled_finished", outcome.sampled_finished},
+                    {"sampled_ns", outcome.sampled_ns}};
+                for (size_t s = 0; s < outcome.stage_ns.size(); ++s)
+                    value["sampled_stage_ns"][stage_names[s]] = outcome.stage_ns[s];
+                for (size_t c = 0; c < outcome.counters.values.size(); ++c)
+                    value["counters"][counter_names[c]] = outcome.counters.values[c];
+                entry[o ? "eliminated" : "survived"] = std::move(value);
+            }
+            result[kind_names[k]] = std::move(entry);
+        }
+        return result;
+    }
+    Json Snapshot(const char* event, bool returned) const {
+        return {{"event", event}, {"pricing_returned", returned},
+            {"elapsed_wall_ns", Ns(Clock::now() - started_)},
+            {"forward", DirectionJson(directions_[0])}, {"backward", DirectionJson(directions_[1])}};
+    }
+    void Write(Json record) {
+        record["schema"] = "kayros-ms58-dominance-profile-v1";
+        record["diagnostic_only"] = true;
+        record["call"] = call_;
+        const auto line = record.dump() + '\n';
+        if (std::fwrite(line.data(), 1, line.size(), file_) != line.size() || std::fflush(file_) != 0)
+            throw std::runtime_error("Cannot write dominance profile");
+    }
+public:
+    DominanceProfile() {
+        const char* path = std::getenv("KAYROS_DOMINANCE_PROFILE");
+        if (!path || !*path) return;
+        stride_ = Integer("KAYROS_DOMINANCE_PROFILE_STRIDE", 1009);
+        offset_ = Integer("KAYROS_DOMINANCE_PROFILE_OFFSET", 0);
+        if (!stride_ || offset_ >= stride_)
+            throw std::runtime_error("Dominance profile requires stride > 0 and offset < stride");
+        file_ = std::fopen(path, "wx");
+        if (!file_) throw std::runtime_error("Cannot exclusively create dominance profile");
+        try {
+            Write({{"event", "profile_open"}, {"base_source", "9d64b7c53ddaea7a578d247ebd28db43ae0d4e56"},
+                {"sample_stride", stride_}, {"sample_offset", offset_},
+                {"sample_rule", "zero_based_call_mod_stride_equals_offset_per_kind_per_direction_per_pricing"},
+                {"clock", "steady_clock"}, {"timer_units", "ns"},
+                {"timing_scope", "sampled call wall time partition including in-call instrumentation; finish aggregation and JSON writes excluded"},
+                {"progress_minimum_seconds", 5},
+                {"unfinished_rule", "no pricing_end means unfinished"},
+                {"outcome_rule", "dominance eliminated means candidate fully eliminated; correction and maintenance eliminated means at least one label retired"}});
+        } catch (...) { std::fclose(file_); file_ = nullptr; throw; }
+    }
+    ~DominanceProfile() { if (file_) std::fclose(file_); }
+    DominanceProfile(const DominanceProfile&) = delete;
+    DominanceProfile& operator=(const DominanceProfile&) = delete;
+    bool Enabled() const { return file_ != nullptr; }
+    Direction* GetDirection(int direction) { return Enabled() ? &directions_.at(direction) : nullptr; }
+    void Begin(Json context) {
+        if (!Enabled()) return;
+        if (active_) throw std::runtime_error("Dominance profile pricing reentry");
+        directions_ = {};
+        for (auto& direction : directions_) direction.owner = this;
+        ++call_;
+        active_ = true;
+        started_ = last_output_ = Clock::now();
+        auto record = Snapshot("pricing_begin", false);
+        record["context"] = std::move(context);
+        Write(std::move(record));
+    }
+    void MaybeProgress() {
+        if (!active_) return;
+        const auto now = Clock::now();
+        if (now - last_output_ < std::chrono::seconds(5)) return;
+        Write(Snapshot("pricing_progress", false));
+        last_output_ = now;
+    }
+    void End(Json native_log, size_t returned_routes, size_t pool_size) {
+        if (!Enabled()) return;
+        if (!active_) throw std::runtime_error("Dominance profile end without begin");
+        auto record = Snapshot("pricing_end", true);
+        record["native_status"] = native_log.at("status");
+        record["native_log"] = std::move(native_log);
+        record["returned_routes"] = returned_routes;
+        record["pool_size"] = pool_size;
+        Write(std::move(record));
+        active_ = false;
+    }
+    class Episode {
+        DominanceProfile* owner_ = nullptr;
+        Operation* operation_ = nullptr;
+        Counters counters_;
+        bool sampled_ = false, finished_ = false;
+        Stage stage_ = Stage::Scan;
+        Clock::time_point start_{}, last_{};
+        std::array<uint64_t, static_cast<size_t>(Stage::Count)> stage_ns_{};
+    public:
+        Episode(Direction* direction, Kind kind) {
+            if (!direction || !direction->owner || !direction->owner->active_) return;
+            owner_ = direction->owner;
+            operation_ = &direction->operations[static_cast<size_t>(kind)];
+            const auto ordinal = operation_->attempts++;
+            sampled_ = ordinal % owner_->stride_ == owner_->offset_;
+            if (sampled_) { ++operation_->sampled_attempts; start_ = last_ = Clock::now(); }
+        }
+        Episode(const Episode&) = delete;
+        Episode& operator=(const Episode&) = delete;
+        bool Sampled() const { return sampled_; }
+        Counters* Accumulator() { return operation_ ? &counters_ : nullptr; }
+        void Add(Counter counter, uint64_t count = 1) { if (operation_ && counter != Counter::Count) counters_.Add(counter, count); }
+        bool Result(bool result, Counter yes, Counter no) { Add(result ? yes : no); return result; }
+        void Switch(Stage stage) {
+            if (sampled_) {
+                const auto now = Clock::now();
+                stage_ns_[static_cast<size_t>(stage_)] += Ns(now - last_);
+                last_ = now;
+            }
+            stage_ = stage;
+        }
+        void Finish(bool eliminated) {
+            if (!operation_ || finished_) return;
+            auto& outcome = operation_->outcomes[eliminated ? 1 : 0];
+            if (sampled_) {
+                const auto now = Clock::now();
+                stage_ns_[static_cast<size_t>(stage_)] += Ns(now - last_);
+                ++outcome.sampled_finished;
+                outcome.sampled_ns += Ns(now - start_);
+                for (size_t s = 0; s < stage_ns_.size(); ++s) outcome.stage_ns[s] += stage_ns_[s];
+            }
+            ++outcome.finished;
+            for (size_t c = 0; c < counters_.values.size(); ++c) outcome.counters.values[c] += counters_.values[c];
+            finished_ = true;
+            // Flush only after the sample timer stops. Destruction never finishes a call.
+            if (sampled_) owner_->MaybeProgress();
+        }
+    };
+};
+} // namespace solver
+#endif
