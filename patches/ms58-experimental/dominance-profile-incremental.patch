@@ -0,0 +1,137 @@
+#include "labeling/dominance_profile.h"
+
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <vector>
+
+using Profile = solver::DominanceProfile;
+using Json = nlohmann::json;
+using C = Profile::Counter;
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+std::vector<Json> read(const std::filesystem::path& path) {
+    std::ifstream input(path);
+    std::vector<Json> records;
+    std::string line;
+    while (std::getline(input, line)) records.push_back(Json::parse(line));
+    return records;
+}
+}
+
+int main() {
+    char pattern[] = "/tmp/kayros-dominance-profile-XXXXXX";
+    const char* directory = mkdtemp(pattern);
+    if (!directory) return 2;
+    const std::filesystem::path root(directory);
+    try {
+        unsetenv("KAYROS_DOMINANCE_PROFILE");
+        Profile disabled;
+        require(!disabled.Enabled() && !disabled.GetDirection(0), "Missing runtime opt-in was ignored");
+        disabled.Begin({});
+        Profile::Episode inactive(nullptr, Profile::Kind::Dominance);
+        require(!inactive.Sampled() && !inactive.Accumulator(), "Inactive call became active");
+        inactive.Add(C::Labels);
+        inactive.Finish(true);
+
+        const auto path = root / "profile.jsonl";
+        setenv("KAYROS_DOMINANCE_PROFILE", path.c_str(), 1);
+        setenv("KAYROS_DOMINANCE_PROFILE_STRIDE", "3", 1);
+        setenv("KAYROS_DOMINANCE_PROFILE_OFFSET", "1", 1);
+        {
+            Profile profile;
+            auto* forward = profile.GetDirection(0);
+            profile.Begin({{"fixture", "sampling"}});
+            require(forward == profile.GetDirection(0), "Reset invalidated the direction pointer");
+            for (int d : {0, 1}) {
+                for (auto kind : {Profile::Kind::Dominance, Profile::Kind::Correction, Profile::Kind::MergeMaintenance}) {
+                    for (int i = 0; i < (d ? 4 : 7); ++i) {
+                        Profile::Episode episode(profile.GetDirection(d), kind);
+                        require(episode.Sampled() == (i % 3 == 1), "Sampling phase leaked across kinds or directions");
+                        episode.Add(C::Labels, 2);
+                        episode.Switch(Profile::Stage::Construction);
+                        episode.Add(C::ScratchFunctions);
+                        episode.Switch(Profile::Stage::Scan);
+                        require(!episode.Result(false, C::PartialTrue, C::PartialFalse), "Result wrapper changed false");
+                        episode.Accumulator()->Add(C::PartialShrinkLeft);
+                        episode.Switch(Profile::Stage::Materialization);
+                        episode.Add(C::Normalizations);
+                        episode.Finish(i % 2 != 0);
+                        episode.Finish(true); // Idempotent, including a different outcome.
+                    }
+                }
+            }
+            profile.MaybeProgress();
+            profile.End({{"status", "TimeLimitReached"}}, 2, 3);
+            profile.Begin({{"fixture", "reset"}});
+            Profile::Episode reset(forward, Profile::Kind::Dominance);
+            require(!reset.Sampled(), "Pricing reset retained sample phase");
+            reset.Add(C::DepotShortcut);
+            reset.Finish(false);
+            profile.End({{"status", "MemoryLimitReached"}}, 0, 0);
+            profile.Begin({{"fixture", "unfinished"}});
+            Profile::Episode unfinished(forward, Profile::Kind::Dominance);
+            unfinished.Add(C::Labels, 99);
+            // Neither episode destruction nor profile destruction implies completion.
+        }
+        const auto records = read(path);
+        require(records.size() == 6, "Unexpected record count");
+        require(records[0]["base_source"] == "9d64b7c53ddaea7a578d247ebd28db43ae0d4e56", "Base identity changed");
+        const auto& end = records[2];
+        require(end["native_status"] == "TimeLimitReached" && end["native_log"]["status"] == "TimeLimitReached",
+                "Native return status was changed");
+        for (const char* direction : {"forward", "backward"}) {
+            const bool fw = std::string(direction) == "forward";
+            for (const char* kind : {"dominance", "correction", "merge_maintenance"}) {
+                const auto& operation = end[direction][kind];
+                require(operation["attempts"] == (fw ? 7 : 4), "Attempt count changed");
+                require(operation["sampled_attempts"] == (fw ? 2 : 1), "Sample count changed");
+                for (const char* outcome : {"survived", "eliminated"}) {
+                    const auto& value = operation[outcome];
+                    const int finished = fw ? (std::string(outcome) == "survived" ? 4 : 3) : 2;
+                    require(value["finished"] == finished, "Outcome classification changed");
+                    require(value["counters"]["labels"] == 2 * finished, "Counters lost outcome attribution");
+                    require(value["counters"]["partial_false"] == finished &&
+                            value["counters"]["partial_shrink_left"] == finished,
+                            "False partial result was treated as unchanged");
+                    uint64_t sum = 0;
+                    for (const auto& stage : value["sampled_stage_ns"]) sum += stage.get<uint64_t>();
+                    require(sum == value["sampled_ns"].get<uint64_t>(), "Stages do not partition whole-call time");
+                }
+            }
+        }
+        const auto& reset = records[4]["forward"]["dominance"];
+        require(reset["attempts"] == 1 && reset["sampled_attempts"] == 0, "Pricing counters did not reset");
+        require(reset["survived"]["counters"]["labels"] == 0 && reset["survived"]["counters"]["depot_shortcut"] == 1,
+                "Counters leaked across pricing calls");
+        require(records[4]["native_status"] == "MemoryLimitReached", "Memory status changed");
+        require(records.back()["event"] == "pricing_begin" && records.back()["pricing_returned"] == false,
+                "Unfinished pricing was silently completed");
+        bool rejected = false;
+        try { Profile collision; } catch (const std::runtime_error&) { rejected = true; }
+        require(rejected && read(path).size() == records.size(), "Exclusive creation overwrote a file");
+        for (const char* stride : {"0", "-1", "3x", ""}) {
+            const auto invalid_path = root / "invalid.jsonl";
+            setenv("KAYROS_DOMINANCE_PROFILE", invalid_path.c_str(), 1);
+            setenv("KAYROS_DOMINANCE_PROFILE_STRIDE", stride, 1);
+            rejected = false;
+            try { Profile invalid; } catch (const std::runtime_error&) { rejected = true; }
+            require(rejected && !std::filesystem::exists(invalid_path), "Invalid settings created output");
+        }
+        setenv("KAYROS_DOMINANCE_PROFILE_STRIDE", "3", 1);
+        setenv("KAYROS_DOMINANCE_PROFILE_OFFSET", "3", 1);
+        rejected = false;
+        try { Profile invalid; } catch (const std::runtime_error&) { rejected = true; }
+        require(rejected, "Offset outside the stride was accepted");
+        std::filesystem::remove_all(root);
+        std::cout << "PASS counters outcome-attribution sampling reset time-partition native-status unfinished exclusive-output invalid-settings\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        std::filesystem::remove_all(root);
+        return 1;
+    }
+}
