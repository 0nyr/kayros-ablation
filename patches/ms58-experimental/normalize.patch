+#pragma once
+
+#include <algorithm>
+#include <utility>
+
+#include "goc/math/pwl_function.h"
+
+namespace solver
+{
+// Repair epsilon-dust piece misordering without copying a well-formed function.
+// Keep the existing boundary scan and reconstruction arithmetic unchanged.
+inline void normalize_pwl(goc::PWLFunction& f)
+{
+    bool ok = true;
+    double hi = -goc::INFTY;
+    for (int k = 0; k < f.PieceCount(); ++k)
+    {
+        const goc::Interval& d = f.Piece(k).domain;
+        if (d.left < hi || d.right < d.left) { ok = false; break; }
+        hi = d.right;
+    }
+    if (ok) return;
+    goc::PWLFunction g;
+    hi = -goc::INFTY;
+    for (int k = 0; k < f.PieceCount(); ++k)
+    {
+        const goc::LinearFunction& p = f.Piece(k);
+        double l = std::max(p.domain.left, hi);
+        double r = p.domain.right;
+        if (r < l) continue;
+        g.AddPiece(goc::LinearFunction({l, p.Value(l)}, {r, p.Value(r)}));
+        hi = r;
+    }
+    f = std::move(g);
+}
+} // namespace solver
