@@ -0,0 +1,115 @@
+// Differential fixture against the frozen pre-optimization normalizer.
+// Link against the candidate's liblera.a with the goc and main include paths.
+#include <bit>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <random>
+#include <vector>
+
+#include "labeling/normalize_pwl.h"
+
+using namespace goc;
+
+static PWLFunction reference_normalize(const PWLFunction& f)
+{
+    bool ok = true;
+    double hi = -INFTY;
+    for (int k = 0; k < f.PieceCount(); ++k)
+    {
+        const Interval& d = f.Piece(k).domain;
+        if (d.left < hi || d.right < d.left) { ok = false; break; }
+        hi = d.right;
+    }
+    if (ok) return f;
+    PWLFunction g;
+    hi = -INFTY;
+    for (int k = 0; k < f.PieceCount(); ++k)
+    {
+        const LinearFunction& p = f.Piece(k);
+        double l = std::max(p.domain.left, hi);
+        double r = p.domain.right;
+        if (r < l) continue;
+        g.AddPiece(LinearFunction({l, p.Value(l)}, {r, p.Value(r)}));
+        hi = r;
+    }
+    return g;
+}
+
+static void require(bool condition)
+{
+    if (!condition) { std::cerr << "normalization regression\n"; std::exit(1); }
+}
+
+static void same(double a, double b)
+{
+    require(std::bit_cast<uint64_t>(a) == std::bit_cast<uint64_t>(b));
+}
+
+static void same(Interval a, Interval b)
+{
+    same(a.left, b.left);
+    same(a.right, b.right);
+}
+
+static void check(PWLFunction input, bool expect_no_reallocation)
+{
+    const auto expected = reference_normalize(input);
+    const auto* storage = input.Pieces().data();
+    solver::normalize_pwl(input);
+    if (expect_no_reallocation) require(storage == input.Pieces().data());
+    require(input.PieceCount() == expected.PieceCount());
+    same(input.Domain(), expected.Domain());
+    same(input.Image(), expected.Image());
+    for (int i = 0; i < input.PieceCount(); ++i)
+    {
+        const auto& a = input.Piece(i);
+        const auto& b = expected.Piece(i);
+        same(a.domain, b.domain);
+        same(a.image, b.image);
+        same(a.slope, b.slope);
+        same(a.intercept, b.intercept);
+    }
+}
+
+int main()
+{
+    int cases = 0;
+    for (bool exact : {false, true})
+    {
+        StepExactArithmeticScope scope(exact);
+        check(PWLFunction(), true);
+        check(PWLFunction::ConstantFunction(-0.0, {2.0, 2.0}), true);
+        cases += 2;
+        std::mt19937_64 rng(58);
+        for (int trial = 0; trial < 1000; ++trial)
+        {
+            PWLFunction f;
+            double x = 0.0;
+            const bool repair = trial % 2;
+            for (int k = 0; k < 12; ++k)
+            {
+                const double width = 1.0 + (rng() % 64) / 8.0;
+                const double y = static_cast<int>(rng() % 128) - 64.0;
+                const double overlap = repair && k % 3 == 1 ? 1e-4 : 0.0;
+                f.AddPiece(LinearFunction({x - overlap, y}, {x + width, y + width / 2.0}));
+                x += width;
+                if (k % 3 == 0)
+                    f.AddPiece(LinearFunction({x, y + width / 2.0}, {x, y + width + 1.0}));
+                if (k % 3 == 2)
+                    f.AddPiece(LinearFunction({x, y + width}, {x, y - 1.0}).as_choice_vertical());
+                if (k == 5)
+                {
+                    LinearFunction dust({x, y}, {x + 1.0, y + 2.0});
+                    if (repair) { dust.domain.left = x + 1e-4; dust.domain.right = x; }
+                    else x += 1.0;
+                    f.AddPiece(dust);
+                }
+                if (k == 8) x += 0.5;
+            }
+            check(std::move(f), !repair);
+            ++cases;
+        }
+    }
+    std::cout << "PASS " << cases << " normalization cases, bit-identical pieces and fast-path storage\n";
+}
