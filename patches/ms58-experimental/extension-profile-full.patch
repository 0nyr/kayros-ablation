+#include "labeling/extension_profile.h"
+
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <vector>
+
+using Profile = solver::ExtensionProfile;
+using Json = nlohmann::json;
+
+namespace {
+void require(bool condition, const char* message)
+{
+    if (!condition) throw std::runtime_error(message);
+}
+
+std::vector<Json> read(const std::filesystem::path& path)
+{
+    std::ifstream input(path);
+    std::vector<Json> result;
+    std::string line;
+    while (std::getline(input, line)) result.push_back(Json::parse(line));
+    return result;
+}
+
+// A noncopyable stand-in checks that ThenCompose forwards the same object
+// and retains the input temporary until assignment has finished.
+struct Temporary {
+    bool* alive;
+    explicit Temporary(bool& flag) : alive(&flag) { *alive = true; }
+    ~Temporary() { *alive = false; }
+    Temporary(const Temporary&) = delete;
+    Temporary(Temporary&&) = delete;
+    int PieceCount() const { return 3; }
+    const Temporary& Compose() const { return *this; }
+};
+struct Assignment {
+    Assignment& operator=(const Temporary& value)
+    {
+        require(*value.alive, "Input temporary died before assignment");
+        return *this;
+    }
+};
+}
+
+int main()
+{
+    char directory_template[] = "/tmp/ms58-extension-profile-XXXXXX";
+    const char* directory = mkdtemp(directory_template);
+    if (!directory) return 2;
+    const std::filesystem::path root(directory);
+    try {
+        unsetenv("KAYROS_EXTENSION_PROFILE");
+        Profile disabled;
+        require(!disabled.Enabled(), "Runtime opt-in must be required");
+        disabled.Begin({});
+        Profile::Episode ignored(nullptr, 0);
+        require(!ignored.Sampled(), "Disabled episodes must not sample");
+
+        setenv("KAYROS_EXTENSION_PROFILE_STRIDE", "3", 1);
+        setenv("KAYROS_EXTENSION_PROFILE_OFFSET", "1", 1);
+        const auto path = root / "profile.jsonl";
+        setenv("KAYROS_EXTENSION_PROFILE", path.c_str(), 1);
+        {
+            Profile profile;
+            require(profile.Enabled(), "Runtime profile did not open");
+            profile.Begin({{"fixture", "sampling"}});
+            for (int direction : {0, 1}) {
+                for (int i = 0; i < (direction == 0 ? 7 : 4); ++i) {
+                    Profile::Episode episode(&profile, direction);
+                    require(episode.Sampled() == (i % 3 == 1), "Sampling ordinal changed");
+                    episode.Switch(Profile::Stage::Addition);
+                    bool alive = false;
+                    Assignment output;
+                    output = episode.ThenCompose(Temporary(alive)).Compose();
+                    require(!alive, "Input temporary outlived the original full expression");
+                    int calls = 0;
+                    const int value = episode.Measure(Profile::Stage::Unreachable, [&] {
+                        ++calls;
+                        return episode.Measure(Profile::Stage::VisitedSet, [&] { return 17; });
+                    });
+                    require(value == 17 && calls == 1, "Nested profiling changed evaluation count");
+                    episode.Mark(Profile::Event::ReturnedLabel);
+                    episode.Finish();
+                    episode.Finish(); // Idempotent, no duplicated sample time.
+                }
+            }
+            profile.End({{"status", "TimeLimitReached"}}, 2, 3);
+            profile.Begin({{"fixture", "reset"}});
+            Profile::Episode episode(&profile, 0);
+            episode.Mark(Profile::Event::ParentEmpty);
+            episode.Finish();
+            profile.End({{"status", "SolutionLimitReached"}}, 0, 0);
+            profile.Begin({{"fixture", "interrupted"}});
+            // Deliberately omit End. Destruction must not imply completion.
+        }
+        const auto records = read(path);
+        require(records.size() == 6, "Unexpected profile record count");
+        const auto& finished = records.at(2);
+        require(finished.at("native_log").at("status") == "TimeLimitReached", "Native status was rewritten");
+        require(finished.at("forward").at("attempts") == 7, "Forward attempt count changed");
+        require(finished.at("backward").at("attempts") == 4, "Backward attempt count changed");
+        require(finished.at("forward").at("sampled_finished") == 2, "Forward sample count changed");
+        require(finished.at("backward").at("sampled_finished") == 1, "Backward sample count changed");
+        for (const char* direction : {"forward", "backward"}) {
+            uint64_t sum = 0;
+            for (const auto& stage : finished.at(direction).at("stages"))
+                sum += stage.at("sampled_ns").get<uint64_t>();
+            require(sum == finished.at(direction).at("sampled_total_ns").get<uint64_t>(),
+                    "Exclusive stages do not partition sampled elapsed time");
+            require(finished.at(direction).at("sampled_attempts") == finished.at(direction).at("sampled_finished"),
+                    "A normally returned sample was left unfinished");
+        }
+        require(records.at(4).at("forward").at("attempts") == 1, "Task counters did not reset");
+        require(records.at(4).at("forward").at("sampled_attempts") == 0, "Sampling phase did not reset");
+        require(records.back().at("event") == "pricing_begin" && !records.back().at("pricing_returned").get<bool>(),
+                "Interrupted task was silently completed");
+        bool rejected = false;
+        try { Profile collision; } catch (const std::runtime_error&) { rejected = true; }
+        require(rejected && read(path).size() == records.size(), "Existing profile was overwritten");
+        setenv("KAYROS_EXTENSION_PROFILE", (root / "invalid.jsonl").c_str(), 1);
+        setenv("KAYROS_EXTENSION_PROFILE_STRIDE", "0", 1);
+        rejected = false;
+        try { Profile invalid; } catch (const std::runtime_error&) { rejected = true; }
+        require(rejected, "Zero sampling stride was accepted");
+        require(!std::filesystem::exists(root / "invalid.jsonl"), "Invalid settings created a file");
+        std::filesystem::remove_all(root);
+        std::cout << "PASS sampling reset exclusive-timers temporary-lifetime unfinished-status exclusive-file invalid-settings\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        std::filesystem::remove_all(root);
+        return 1;
+    }
+}
diff --git a/tests/cpp/test_extension_profile_pwl.cpp b/tests/cpp/test_extension_profile_pwl.cpp
new file mode 100644
index 0000000..9061262
--- /dev/null
+++ b/tests/cpp/test_extension_profile_pwl.cpp
@@ -0,0 +1,92 @@
+#include "labeling/extension_profile.h"
+#include "goc/math/pwl_function.h"
+
+#include <bit>
+#include <filesystem>
+#include <iostream>
+
+using Profile = solver::ExtensionProfile;
+using namespace goc;
+
+namespace {
+void require(bool condition, const char* message)
+{
+    if (!condition) throw std::runtime_error(message);
+}
+bool same(double left, double right)
+{
+    return std::bit_cast<uint64_t>(left) == std::bit_cast<uint64_t>(right);
+}
+void same_function(const PWLFunction& left, const PWLFunction& right)
+{
+    require(left.PieceCount() == right.PieceCount(), "Profile wrapper changed piece count");
+    require(same(left.Domain().left, right.Domain().left) && same(left.Domain().right, right.Domain().right), "Profile wrapper changed domain");
+    require(same(left.Image().left, right.Image().left) && same(left.Image().right, right.Image().right), "Profile wrapper changed image");
+    for (int i = 0; i < left.PieceCount(); ++i) {
+        const auto& a = left.Piece(i);
+        const auto& b = right.Piece(i);
+        require(same(a.domain.left, b.domain.left) && same(a.domain.right, b.domain.right)
+            && same(a.image.left, b.image.left) && same(a.image.right, b.image.right)
+            && same(a.slope, b.slope) && same(a.intercept, b.intercept), "Profile wrapper changed piece bits or vertical tags");
+    }
+}
+PWLFunction fixture(int variant)
+{
+    PWLFunction f;
+    f.AddPiece(LinearFunction({0.0, 8.0}, {1.0, 8.5}));
+    for (int i = 0; i < 1 + variant % 9; ++i) {
+        auto piece = LinearFunction({1.0, 8.5 - i * 0.125}, {1.0, 8.5 - (i + 1) * 0.125});
+        if (variant % 2) piece = piece.as_choice_vertical();
+        f.AddPiece(piece);
+    }
+    f.AddPiece(LinearFunction({1.0, 8.0}, {2.0, 9.0}));
+    return f;
+}
+}
+
+int main()
+{
+    char path_template[] = "/tmp/ms58-extension-pwl-XXXXXX";
+    const char* directory = mkdtemp(path_template);
+    if (!directory) return 2;
+    const std::filesystem::path root(directory);
+    try {
+        setenv("KAYROS_EXTENSION_PROFILE", (root / "fixture.jsonl").c_str(), 1);
+        setenv("KAYROS_EXTENSION_PROFILE_STRIDE", "3", 1);
+        setenv("KAYROS_EXTENSION_PROFILE_OFFSET", "0", 1);
+        Profile profile;
+        profile.Begin({{"fixture", "pwl_expression_equivalence"}});
+        int comparisons = 0;
+        for (bool exact : {false, true}) {
+            StepExactArithmeticScope arithmetic(exact);
+            for (int i = 0; i < 64; ++i) {
+                const auto f = fixture(i);
+                const auto travel = PWLFunction::ConstantFunction(19.0, i % 3 ? Interval{0.0, 2.0} : Interval{1.0, 1.0});
+                const auto departure = i % 3 ? PWLFunction::IdentityFunction({0.0, 2.0}) : PWLFunction::ConstantFunction(1.0, {20.0, 20.0});
+                Profile::Episode episode(&profile, i % 2);
+                const auto expected = (f + travel).Compose(departure);
+                episode.Switch(Profile::Stage::Addition);
+                const auto observed = episode.ThenCompose(f + travel).Compose(departure);
+                same_function(expected, observed);
+                const auto expected_comp = (f - PWLFunction::IdentityFunction(f.Domain())).Compose(departure);
+                episode.Switch(Profile::Stage::Subtraction);
+                const auto observed_comp = episode.ThenCompose(f - PWLFunction::IdentityFunction(f.Domain())).Compose(departure);
+                same_function(expected_comp, observed_comp);
+                const auto expected_step = expected_comp.Empty() ? expected_comp : expected_comp + PWLFunction::IdentityFunction(expected_comp.Domain());
+                episode.Switch(Profile::Stage::Addition);
+                const auto observed_step = observed_comp.Empty() ? observed_comp : observed_comp + PWLFunction::IdentityFunction(observed_comp.Domain());
+                same_function(expected_step, observed_step);
+                episode.Finish();
+                comparisons += 3;
+            }
+        }
+        profile.End({{"status", "fixture_only"}}, 0, 0);
+        std::filesystem::remove_all(root);
+        std::cout << "PASS bitwise PWL expression comparisons=" << comparisons << '\n';
+        return 0;
+    } catch (const std::exception& error) {
+        std::filesystem::remove_all(root);
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/cpp/test_ordered_valuation.cpp b/tests/cpp/test_ordered_valuation.cpp
new file mode 100644
index 0000000..6b15f9e
--- /dev/null
+++ b/tests/cpp/test_ordered_valuation.cpp
@@ -0,0 +1,65 @@
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <numeric>
+#include <random>
+#include <set>
+
+#include "bcp/ordered_valuation.h"
+#include "goc/linear_programming/highs/matrix_formulation.h"
+
+static void require(bool value)
+{
+    if (!value) { std::cerr << "ordered valuation regression\n"; std::exit(1); }
+}
+
+int main()
+{
+    // Fractional values from the captured C201 root LP, including its dust.
+    const std::array<double, 23> values{
+        .05, .05, .05, .05, .05, .05, .05, .05, .05, .05,
+        .05000000000000007, .05, .05, .05, .049999999999999795,
+        .05, .050000000000000114, .05, .05, .049999999999999906,
+        .049999999999999836, 1., 1.};
+    std::mt19937 rng(58);
+    std::set<uint64_t> raw_results;
+    std::array<uint64_t, 3> expected{};
+    for (int trial = 0; trial < 128; ++trial)
+    {
+        goc::MatrixFormulation formulation;
+        std::vector<goc::Variable> variables;
+        for (int index = 0; index < (int) values.size(); ++index)
+            variables.push_back(formulation.AddVariable("y_" + std::to_string(index)));
+        std::vector<int> order(values.size());
+        std::iota(order.begin(), order.end(), 0);
+        std::shuffle(order.begin(), order.end(), rng);
+        goc::Valuation valuation;
+        for (int index : order) valuation.SetValue(variables[index], values[index]);
+        double raw = 0.;
+        for (const auto& item : valuation) raw += item.second;
+        raw_results.insert(std::bit_cast<uint64_t>(raw));
+        auto sorted = solver::ordered_valuation(valuation);
+        require(sorted.size() == values.size());
+        std::array<double, 3> sums{};
+        for (int index = 0; index < (int) sorted.size(); ++index)
+        {
+            require(sorted[index].first.Index() == index);
+            require(std::bit_cast<uint64_t>(sorted[index].second) == std::bit_cast<uint64_t>(values[index]));
+            sums[0] += sorted[index].second;
+            if (index % 3) sums[1] += sorted[index].second;
+            if (index % 2) sums[2] += sorted[index].second;
+        }
+        for (int index = 0; index < 3; ++index)
+        {
+            uint64_t bits = std::bit_cast<uint64_t>(sums[index]);
+            if (trial == 0) expected[index] = bits;
+            else require(bits == expected[index]);
+        }
+    }
+    require(raw_results.size() > 1);
+    std::cout << "PASS 128 valuation permutations, invariant canonical reductions, "
+              << raw_results.size() << " distinct raw sum bit patterns\n";
+}
diff --git a/tests/cpp/test_point_addition.cpp b/tests/cpp/test_point_addition.cpp
new file mode 100644
index 0000000..545ed1e
--- /dev/null
+++ b/tests/cpp/test_point_addition.cpp
@@ -0,0 +1,84 @@
+#include "goc/math/pwl_function.h"
+
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+void require(bool condition, const char* message)
+{
+    if (!condition) throw std::runtime_error(message);
+}
+
+goc::PWLFunction choices()
+{
+    goc::PWLFunction f;
+    f.AddPiece(goc::LinearFunction({770.0, 62.6125}, {770.0, 50.425}).as_choice_vertical());
+    f.AddPiece(goc::LinearFunction({770.0, 50.425}, {770.0, 50.0}).as_choice_vertical());
+    f.AddPiece(goc::LinearFunction({770.0, 50.0}, {770.0, 41.0272189349112}).as_choice_vertical());
+    f.AddPiece(goc::LinearFunction({770.0, 41.0272189349112}, {771.0, 41.1195266272189}));
+    return f;
+}
+
+void check(bool step_exact)
+{
+    goc::StepExactArithmeticScope scope(step_exact);
+    const auto f = choices();
+    const auto travel = goc::PWLFunction::ConstantFunction(19.0, {770.0, 770.0});
+    const auto departure = goc::PWLFunction::ConstantFunction(770.0, {789.0, 789.0});
+    const double expected = f.MinValueAt(770.0) + 19.0;
+    for (const auto& sum : {f + travel, travel + f})
+    {
+        require(sum.Domain().left == 770.0 && sum.Domain().right == 770.0,
+                "A scalar point must restrict the sum to its abscissa");
+        require(std::abs(sum.MinValueAt(770.0) - expected) < 1e-10,
+                "Adding a scalar point lost an attainable departure choice");
+        const auto extended = sum.Compose(departure);
+        require(std::abs(extended.MinValueAt(789.0) - expected) < 1e-10,
+                "Tight-arc extension must retain the best prefix duration");
+    }
+    const auto outside = goc::PWLFunction::ConstantFunction(19.0, {772.0, 772.0});
+    require((f + outside).Empty() && (outside + f).Empty(),
+            "A disjoint point must not create a new feasible time");
+    const auto ordinary = goc::PWLFunction::ConstantFunction(2.0, {0.0, 4.0});
+    const auto point = goc::PWLFunction::ConstantFunction(3.0, {4.0, 4.0});
+    require((ordinary + point).MinValueAt(4.0) == 5.0,
+            "Ordinary scalar-point addition must remain unchanged");
+
+    goc::PWLFunction boundary;
+    boundary.AddPiece(goc::LinearFunction({760.0, 43.0}, {770.0, 43.0}));
+    boundary.AddPiece(goc::LinearFunction({770.0, 43.0}, {770.0, 41.0}).as_choice_vertical());
+    for (const auto& sum : {boundary + travel, travel + boundary})
+        require(sum.MinValueAt(770.0) == 60.0,
+                "An ordinary segment followed by a boundary choice must retain the choice");
+
+    goc::PWLFunction jump;
+    jump.AddPiece(goc::LinearFunction({0.0, 2.0}, {1.0, 2.0}));
+    jump.AddPiece(goc::LinearFunction({1.0, 2.0}, {1.0, 8.0}));
+    jump.AddPiece(goc::LinearFunction({1.0, 8.0}, {2.0, 8.0}));
+    const auto at_jump = goc::PWLFunction::ConstantFunction(3.0, {1.0, 1.0});
+    for (const auto& sum : {jump + at_jump, at_jump + jump})
+    {
+        require(sum.PieceCount() == 2 && sum.Piece(1).is_jump_vertical(),
+                "The point-choice repair must leave the unrelated JUMP sweep unchanged");
+        require(sum.Value(1.0) == 5.0,
+                "The attained side of an unrelated JUMP must remain unchanged");
+    }
+}
+}
+
+int main()
+{
+    try
+    {
+        check(false);
+        check(true);
+        std::cout << "Point-addition and tight-extension invariants pass in legacy and step-exact modes\n";
+        return 0;
+    }
+    catch (const std::exception& error)
+    {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
