diff --git a/cpp/lera/main/include/labeling/extension_profile.h b/cpp/lera/main/include/labeling/extension_profile.h
new file mode 100644
index 0000000..331953c
--- /dev/null
+++ b/cpp/lera/main/include/labeling/extension_profile.h
@@ -0,0 +1,287 @@
+#pragma once
+
+// Experimental ms58 instrumentation. This header and all call sites are excluded
+// unless KAYROS_EXTENSION_PROFILING is enabled for the lera target.
+#ifdef KAYROS_EXTENSION_PROFILING
+
+#include <array>
+#include <charconv>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+#include "goc/lib/json.hpp"
+
+namespace solver
+{
+class ExtensionProfile
+{
+public:
+    using Clock = std::chrono::steady_clock;
+    using Json = nlohmann::json;
+    enum class Stage {
+        Feasibility, AllocationResources, ArithmeticGate, BeforeWindow,
+        Addition, Subtraction, Composition, Restriction, Normalization,
+        VisitedSet, Unreachable, CutResources, Finalize, Count
+    };
+    enum class Event {
+        ParentEmpty, ArrivalInfinite, DepotTriangle, BeforeWindow, StepArc,
+        LegacyArc, NormalizeFast, NormalizeRebuilt, DurationEmpty,
+        NgVisited, FullVisited, StrongUnreachable, WeakUnreachable,
+        ReturnedLabel, Count
+    };
+    enum class Pieces { Parent, Travel, Departure, Arithmetic, Composed, Normalized, Count };
+
+private:
+    struct StageTotals {
+        uint64_t entries = 0, sampled_entries = 0, sampled_ns = 0;
+    };
+    struct PieceTotals {
+        uint64_t observations = 0, sum = 0, maximum = 0;
+    };
+    struct Totals {
+        uint64_t attempts = 0, sampled_attempts = 0, sampled_finished = 0;
+        uint64_t sampled_total_ns = 0;
+        std::array<StageTotals, static_cast<size_t>(Stage::Count)> stages{};
+        std::array<uint64_t, static_cast<size_t>(Event::Count)> events{};
+        std::array<PieceTotals, static_cast<size_t>(Pieces::Count)> pieces{};
+    };
+
+    FILE* file_ = nullptr;
+    uint64_t stride_ = 1009, offset_ = 0, call_ = 0;
+    std::array<Totals, 2> totals_{};
+    Clock::time_point started_{}, last_output_{};
+    bool active_ = false;
+
+    static uint64_t EnvInteger(const char* name, uint64_t fallback)
+    {
+        const char* value = std::getenv(name);
+        if (!value) return fallback;
+        uint64_t result = 0;
+        const char* end = value + std::strlen(value);
+        const auto parsed = std::from_chars(value, end, result);
+        if (parsed.ec != std::errc{} || parsed.ptr != end)
+            throw std::runtime_error(std::string("Invalid extension profile integer: ") + name);
+        return result;
+    }
+
+    static uint64_t Nanoseconds(Clock::duration value)
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(value).count();
+    }
+
+    void Write(Json record)
+    {
+        record["schema"] = "kayros-ms58-extension-profile-v1";
+        record["diagnostic_only"] = true;
+        record["call"] = call_;
+        const auto line = record.dump() + '\n';
+        if (std::fwrite(line.data(), 1, line.size(), file_) != line.size() || std::fflush(file_) != 0)
+            throw std::runtime_error("Cannot write extension profile");
+    }
+
+    Json Direction(int direction) const
+    {
+        static constexpr const char* stage_names[] = {
+            "feasibility", "allocation_scalar_resources", "arithmetic_gate",
+            "before_window", "pwl_addition", "pwl_subtraction", "pwl_composition",
+            "domain_restriction", "normalization", "visited_set", "unreachable",
+            "cut_resources", "finalize"
+        };
+        static constexpr const char* event_names[] = {
+            "reject_parent_empty", "reject_arrival_infinite", "reject_depot_triangle",
+            "branch_before_window", "branch_step_arc", "branch_legacy_arc",
+            "normalize_fast", "normalize_rebuilt", "reject_duration_empty",
+            "visited_ng", "visited_full", "unreachable_strong", "unreachable_weak",
+            "returned_label"
+        };
+        static constexpr const char* piece_names[] = {
+            "parent", "travel", "departure", "arithmetic_result", "composed", "normalized"
+        };
+        static_assert(std::size(stage_names) == static_cast<size_t>(Stage::Count));
+        static_assert(std::size(event_names) == static_cast<size_t>(Event::Count));
+        static_assert(std::size(piece_names) == static_cast<size_t>(Pieces::Count));
+        const auto& t = totals_[direction];
+        Json result = {{"attempts", t.attempts}, {"sampled_attempts", t.sampled_attempts},
+            {"sampled_finished", t.sampled_finished}, {"sampled_total_ns", t.sampled_total_ns}};
+        for (size_t i = 0; i < t.stages.size(); ++i) {
+            const auto& s = t.stages[i];
+            result["stages"][stage_names[i]] = {{"entries", s.entries},
+                {"sampled_entries", s.sampled_entries}, {"sampled_ns", s.sampled_ns}};
+        }
+        for (size_t i = 0; i < t.events.size(); ++i)
+            result["events"][event_names[i]] = t.events[i];
+        for (size_t i = 0; i < t.pieces.size(); ++i) {
+            const auto& p = t.pieces[i];
+            result["sampled_pieces"][piece_names[i]] = {{"observations", p.observations},
+                {"sum", p.sum}, {"maximum", p.maximum}};
+        }
+        return result;
+    }
+
+    Json Snapshot(const char* event, bool returned) const
+    {
+        return {{"event", event}, {"pricing_returned", returned},
+            {"elapsed_wall_ns", Nanoseconds(Clock::now() - started_)},
+            {"forward", Direction(0)}, {"backward", Direction(1)}};
+    }
+
+public:
+    ExtensionProfile()
+    {
+        const char* path = std::getenv("KAYROS_EXTENSION_PROFILE");
+        if (!path || !*path) return;
+        stride_ = EnvInteger("KAYROS_EXTENSION_PROFILE_STRIDE", 1009);
+        offset_ = EnvInteger("KAYROS_EXTENSION_PROFILE_OFFSET", 0);
+        if (stride_ == 0 || offset_ >= stride_)
+            throw std::runtime_error("Extension profile requires stride > 0 and offset < stride");
+        file_ = std::fopen(path, "wx");
+        if (!file_) throw std::runtime_error("Cannot exclusively create extension profile");
+        try {
+            Write({{"event", "profile_open"}, {"base_source", "327e481713e1b9a3187fda2fc9f10f8d9d75b0c5"},
+                {"sample_stride", stride_}, {"sample_offset", offset_},
+                {"sample_rule", "zero_based_attempt_mod_stride_equals_offset_per_direction_per_task"},
+                {"clock", "steady_clock"}, {"timer_units", "ns"},
+                {"timing_scope", "exclusive sampled extension stage wall time including instrumentation"},
+                {"progress_minimum_seconds", 5}, {"unfinished_rule", "no pricing_end means unfinished"}});
+        } catch (...) {
+            std::fclose(file_);
+            file_ = nullptr;
+            throw;
+        }
+    }
+
+    ~ExtensionProfile() { if (file_) std::fclose(file_); }
+    ExtensionProfile(const ExtensionProfile&) = delete;
+    ExtensionProfile& operator=(const ExtensionProfile&) = delete;
+    bool Enabled() const { return file_ != nullptr; }
+
+    void Begin(Json context)
+    {
+        if (!Enabled()) return;
+        if (active_) throw std::runtime_error("Extension profile task reentry");
+        totals_ = {};
+        ++call_;
+        started_ = last_output_ = Clock::now();
+        active_ = true;
+        Json record = Snapshot("pricing_begin", false);
+        record["context"] = std::move(context);
+        Write(std::move(record));
+    }
+
+    void MaybeProgress()
+    {
+        if (!active_) return;
+        const auto now = Clock::now();
+        if (now - last_output_ < std::chrono::seconds(5)) return;
+        Write(Snapshot("pricing_progress", false));
+        last_output_ = now;
+    }
+
+    void End(Json native_log, size_t returned_routes, size_t pool_size)
+    {
+        if (!Enabled()) return;
+        Json record = Snapshot("pricing_end", true);
+        record["native_log"] = std::move(native_log);
+        record["returned_routes"] = returned_routes;
+        record["pool_size"] = pool_size;
+        Write(std::move(record));
+        active_ = false;
+    }
+
+    class Episode
+    {
+        ExtensionProfile* owner_;
+        Totals* totals_ = nullptr;
+        Stage stage_ = Stage::Feasibility;
+        bool sampled_ = false, finished_ = false;
+        Clock::time_point start_{}, last_{};
+
+    public:
+        Episode(ExtensionProfile* owner, int direction) : owner_(owner)
+        {
+            if (!owner || !owner->active_) return;
+            totals_ = &owner->totals_[direction];
+            const auto ordinal = totals_->attempts++;
+            sampled_ = ordinal % owner->stride_ == owner->offset_;
+            ++totals_->stages[static_cast<size_t>(stage_)].entries;
+            if (sampled_) {
+                ++totals_->sampled_attempts;
+                ++totals_->stages[static_cast<size_t>(stage_)].sampled_entries;
+                start_ = last_ = Clock::now();
+            }
+        }
+        // Finish is explicit on all normal returns. An exception leaves a
+        // sampled attempt unfinished and the pricing begin unmatched.
+        Episode(const Episode&) = delete;
+        Episode& operator=(const Episode&) = delete;
+        bool Sampled() const { return sampled_; }
+
+        void Switch(Stage stage)
+        {
+            if (!totals_) return;
+            if (sampled_) {
+                const auto now = Clock::now();
+                totals_->stages[static_cast<size_t>(stage_)].sampled_ns += Nanoseconds(now - last_);
+                last_ = now;
+                ++totals_->stages[static_cast<size_t>(stage)].sampled_entries;
+            }
+            stage_ = stage;
+            ++totals_->stages[static_cast<size_t>(stage)].entries;
+        }
+        void Mark(Event event)
+        {
+            if (totals_) ++totals_->events[static_cast<size_t>(event)];
+        }
+        void Observe(Pieces kind, int count)
+        {
+            if (!sampled_) return;
+            auto& p = totals_->pieces[static_cast<size_t>(kind)];
+            ++p.observations;
+            p.sum += count;
+            if (static_cast<uint64_t>(count) > p.maximum) p.maximum = count;
+        }
+        template<class Function>
+        Function&& ThenCompose(Function&& value)
+        {
+            if (sampled_) Observe(Pieces::Arithmetic, value.PieceCount());
+            Switch(Stage::Composition);
+            // Forward the same temporary into Compose. Its lifetime still
+            // ends at the original full expression, after the assignment.
+            return std::forward<Function>(value);
+        }
+        template<class Function>
+        auto Measure(Stage stage, Function&& function) -> decltype(function())
+        {
+            const Stage previous = stage_;
+            Switch(stage);
+            // Used for scalar/bitset work. PWL expressions use ThenCompose
+            // to retain their original temporary lifetime and assignment.
+            struct Restore {
+                Episode& episode;
+                Stage previous;
+                ~Restore() { episode.Switch(previous); }
+            } restore{*this, previous};
+            return function();
+        }
+        void Finish()
+        {
+            if (!totals_ || finished_) return;
+            finished_ = true;
+            if (sampled_) {
+                const auto now = Clock::now();
+                totals_->stages[static_cast<size_t>(stage_)].sampled_ns += Nanoseconds(now - last_);
+                totals_->sampled_total_ns += Nanoseconds(now - start_);
+                ++totals_->sampled_finished;
+                owner_->MaybeProgress();
+            }
+        }
+    };
+};
+} // namespace solver
+#endif
