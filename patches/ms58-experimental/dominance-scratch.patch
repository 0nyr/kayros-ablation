diff --git a/tests/cpp/test_dominance_scratch.cpp b/tests/cpp/test_dominance_scratch.cpp
new file mode 100644
index 0000000..e5ec8a8
--- /dev/null
+++ b/tests/cpp/test_dominance_scratch.cpp
@@ -0,0 +1,117 @@
+#include "labeling/pwl_domination_function.h"
+
+#include <bit>
+#include <cstdint>
+#include <cstdlib>
+#include <iostream>
+#include <new>
+#include <stdexcept>
+
+namespace {
+bool counting_allocations = false;
+std::size_t allocation_count = 0;
+}
+
+void* operator new(std::size_t size) {
+    if (counting_allocations) ++allocation_count;
+    if (void* memory = std::malloc(size ? size : 1)) return memory;
+    throw std::bad_alloc();
+}
+void operator delete(void* memory) noexcept { std::free(memory); }
+void operator delete(void* memory, std::size_t) noexcept { std::free(memory); }
+
+using namespace goc;
+using solver::PWLDominationFunction;
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+bool same(double left, double right) {
+    return std::bit_cast<std::uint64_t>(left) == std::bit_cast<std::uint64_t>(right);
+}
+
+void same_function(const PWLFunction& left, const PWLFunction& right) {
+    require(left.PieceCount() == right.PieceCount(), "Piece count changed after scratch reset");
+    require(same(left.Domain().left, right.Domain().left) && same(left.Domain().right, right.Domain().right), "Domain changed after scratch reset");
+    require(same(left.Image().left, right.Image().left) && same(left.Image().right, right.Image().right), "Image changed after scratch reset");
+    for (int i = 0; i < left.PieceCount(); ++i) {
+        const auto& a = left.Piece(i);
+        const auto& b = right.Piece(i);
+        require(same(a.domain.left, b.domain.left) && same(a.domain.right, b.domain.right)
+                && same(a.image.left, b.image.left) && same(a.image.right, b.image.right)
+                && same(a.slope, b.slope) && same(a.intercept, b.intercept), "Piece arithmetic or vertical tag changed after scratch reset");
+    }
+}
+
+PWLFunction fixture(int index) {
+    PWLFunction result;
+    if (index % 11 == 0) return result;
+    const int pieces = 1 + index % 19;
+    for (int i = 0; i < pieces; ++i) {
+        const double x = 2.0 * i;
+        const double y = 3.0 + 0.25 * ((index + i) % 7);
+        result.AddPiece(LinearFunction({x, y}, {x + 2.0, y + (i % 2 ? 1.0 : -0.5)}));
+        if (i + 1 < pieces && (index + i) % 3 == 0) {
+            auto vertical = LinearFunction({x + 2.0, y + 1.0}, {x + 2.0, y - 0.5});
+            if (index % 2) vertical = vertical.as_choice_vertical();
+            result.AddPiece(vertical);
+        }
+    }
+    return result;
+}
+}
+
+int main() {
+    try {
+        PWLDominationFunction reused;
+        std::size_t cases = 0;
+        for (bool exact : {false, true}) {
+            StepExactArithmeticScope scope(exact);
+            for (int iteration = 0; iteration < 512; ++iteration) {
+                const auto input = fixture(iteration);
+                PWLDominationFunction fresh(input);
+                reused.Reset(input);
+                same_function(static_cast<PWLFunction>(fresh), static_cast<PWLFunction>(reused));
+                if (!input.Empty()) {
+                    for (int pass = 0; pass < 3; ++pass) {
+                        PWLFunction dominator({LinearFunction({0.0, 2.0 + pass}, {64.0, 4.0 + pass})});
+                        const bool expected = fresh.DominatePieces(dominator, 0.25 * (iteration % 5));
+                        const bool observed = reused.DominatePieces(dominator, 0.25 * (iteration % 5));
+                        require(expected == observed, "Domination verdict changed after scratch reset");
+                        same_function(static_cast<PWLFunction>(fresh), static_cast<PWLFunction>(reused));
+                    }
+                }
+                if (iteration % 13 == 0) reused.Release();
+                ++cases;
+            }
+        }
+        const auto input = fixture(37);
+        reused.Reset(input);
+        allocation_count = 0;
+        counting_allocations = true;
+        for (int i = 0; i < 1000; ++i) {
+            PWLDominationFunction fresh(input);
+            if (fresh.Empty()) std::abort();
+        }
+        counting_allocations = false;
+        const auto fresh_allocations = allocation_count;
+        allocation_count = 0;
+        counting_allocations = true;
+        for (int i = 0; i < 1000; ++i) reused.Reset(input);
+        counting_allocations = false;
+        const auto reused_allocations = allocation_count;
+        require(fresh_allocations >= 2000, "Fresh construction did not exercise both allocation sites");
+        require(reused_allocations == 0, "Fixed-size scratch reset still allocated");
+        reused.Release();
+        require(reused.Empty(), "Release left logical pieces");
+        std::cout << "PASS cases=" << cases << " fresh_allocations=" << fresh_allocations
+                  << " reused_allocations=" << reused_allocations << '\n';
+        return 0;
+    } catch (const std::exception& error) {
+        counting_allocations = false;
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
