diff --git a/tests/cpp/test_label_correction.cpp b/tests/cpp/test_label_correction.cpp
new file mode 100644
index 0000000..651142b
--- /dev/null
+++ b/tests/cpp/test_label_correction.cpp
@@ -0,0 +1,255 @@
+#include <goc/goc.h>
+#include <nyr/nyr.h>
+
+#include <iostream>
+#include <optional>
+#include <stdexcept>
+#include <string>
+
+#include "labeling/bidirectional_labeling.h"
+
+using namespace goc;
+using namespace nyr;
+using namespace solver;
+
+namespace solver {
+struct CorrectionInvariantTest {
+    static MonodirectionalLabeling& Mono(BidirectionalLabeling& solver) { return solver.lbl_[0]; }
+    static int Correct(MonodirectionalLabeling& solver, Label* label) { return solver.CorrectionStep(label); }
+    static bool Dominated(MonodirectionalLabeling& solver, Label* label) { return solver.DominationStep(label); }
+    static Label* Extend(MonodirectionalLabeling& solver, const LazyLabel& label) { return solver.ExtensionStep(label); }
+    static std::size_t Retired(MonodirectionalLabeling& solver) { return solver.retired_labels_.size(); }
+    static std::size_t Changes(MonodirectionalLabeling& solver) { return solver.corrected_merge_buckets_.size(); }
+    static void ConfigureDelayedExtension(MonodirectionalLabeling& solver) {
+        solver.pp_.P = std::vector<double>(5, 0.0);
+        solver.vrp_.D.AddArc({0, 1});
+        solver.vrp_.q[1] = 1.0;
+        solver.vrp_.tau[0][1] = solver.vrp_.pretau[0][1] = PWLFunction::ConstantFunction(0.0, {0.0, 10.0});
+        solver.vrp_.arr[0][1] = solver.vrp_.dep[0][1] = PWLFunction::IdentityFunction({0.0, 10.0});
+        solver.vrp_.LDT = Matrix<double>(5, 5, 10.0);
+    }
+    static void Refresh(BidirectionalLabeling& solver) { solver.RefreshCorrectedMergeLabels(0); }
+    static auto& Pool(BidirectionalLabeling& solver) {
+        if (solver.M[0].empty()) solver.M[0].resize(5);
+        return solver.M[0][1].Insert(1, {});
+    }
+    static std::size_t MergePool(BidirectionalLabeling& solver, Label* label) {
+        solver.pp_.P = std::vector<double>(5, 0.0);
+        solver.S.clear();
+        solver.IterativeMerge(label, solver.M[0]);
+        return solver.S.size();
+    }
+    static void Clean(BidirectionalLabeling& solver) {
+        solver.M[0].clear();
+        solver.lbl_[0].Clean();
+    }
+};
+}
+
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+VRPInstance instance() {
+    VRPInstance vrp;
+    vrp.D = Digraph(5);
+    vrp.o = 0;
+    vrp.d = 4;
+    vrp.T = 10;
+    vrp.horizon = {0.0, 10.0};
+    vrp.Q = 100;
+    vrp.q = std::vector<double>(5, 0.0);
+    vrp.tw = std::vector<goc::Interval>(5, {0.0, 10.0});
+    vrp.tau = Matrix<PWLFunction>(5, 5);
+    vrp.pretau = Matrix<PWLFunction>(5, 5);
+    vrp.arr = Matrix<PWLFunction>(5, 5);
+    vrp.dep = Matrix<PWLFunction>(5, 5);
+    vrp.LDT = Matrix<double>(5, 5);
+    vrp.tau[0][0] = PWLFunction::ConstantFunction(0.0, {0.0, 10.0});
+    return vrp;
+}
+
+void initialize(Label& label, PWLFunction duration, VertexSet unreachable) {
+    label.parent = nullptr;
+    label.v = 1;
+    label.q = 1;
+    label.p = label.cut_cost = 0;
+    label.duration = duration;
+    label.rw = duration.Domain();
+    label.min_cost = std::min(img(duration));
+    label.U = unreachable;
+}
+
+template <typename Function>
+void require_eager_rejection(Function operation) {
+    bool rejected = false;
+    try {
+        operation();
+    } catch (const std::invalid_argument& error) {
+        rejected = std::string(error.what()) == "Label correction requires lazy extension";
+    }
+    require(rejected, "Correction with eager extension must be rejected explicitly");
+}
+
+void check_default_and_eager_guard(bool step_exact) {
+    StepExactArithmeticScope arithmetic(step_exact);
+    const std::optional<TDNGRoutesParams> ng = std::nullopt;
+    BidirectionalLabeling bidirectional(instance(), ng);
+    MonodirectionalLabeling mono(instance(), ng);
+    require(bidirectional.correcting && mono.correcting,
+            "Experimental candidate must enable correction by default");
+    require(bidirectional.lazy_extension && mono.lazy_extension,
+            "Experimental candidate must preserve the default lazy extension mode");
+    mono.Init();
+    LBQueue queue;
+    MLBExecutionLog log(true);
+    require(mono.Run(&queue, &log).empty(), "Default lazy mode must allow an empty queue");
+    mono.lazy_extension = false;
+    require_eager_rejection([&] { mono.Init(); });
+    require_eager_rejection([&] { mono.Run(&queue, &log); });
+    bidirectional.lazy_extension = false;
+    PricingProblem problem;
+    std::vector<Route> routes;
+    require_eager_rejection([&] { bidirectional.Run(problem, &routes, LabelingLevel::Exact); });
+    require(queue.empty() && routes.empty(), "Rejected modes must not mutate output queues or routes");
+    mono.correcting = bidirectional.correcting = false;
+    require(!mono.correcting && !bidirectional.correcting,
+            "Native callers must retain an explicit correction-off control");
+    require(mono.Run(&queue, &log).empty(), "Correction-off eager mode must not trigger the correction guard");
+}
+
+void check(bool step_exact, bool sort_by_cost) {
+    StepExactArithmeticScope arithmetic(step_exact);
+    const std::optional<TDNGRoutesParams> ng = std::nullopt;
+    BidirectionalLabeling bidirectional(instance(), ng);
+    require(bidirectional.correcting, "Experimental candidate must enable correction by default");
+    bidirectional.correcting = true;
+    bidirectional.closing_state = false;
+    auto& mono = CorrectionInvariantTest::Mono(bidirectional);
+    mono.correcting = true;
+    mono.sort_by_cost = sort_by_cost;
+    VertexSet a, b;
+    a.set(1).set(2).set(4);
+    b.set(1).set(3).set(4);
+    auto* first = new Label;
+    auto* second = new Label;
+    PWLFunction rising;
+    rising.AddPiece(LinearFunction({0.0, 0.0}, {10.0, 5.0}));
+    initialize(*first, rising, a);
+    initialize(*second, PWLFunction::ConstantFunction(0.5, {0.0, 10.0}), b);
+    auto& bucket = mono.U[1].Insert(1, {});
+    bucket = {first, second};
+    CorrectionInvariantTest::Pool(bidirectional) = {first, second};
+    Label arriving;
+    initialize(arriving, PWLFunction::ConstantFunction(0.0, {0.0, 1.0}), a);
+    require(CorrectionInvariantTest::Correct(mono, &arriving) == 0, "Expected partial correction only");
+    require(first->min_cost == 1.0, "Expected partial correction to increase the minimum cost");
+    require(bucket[0] == (sort_by_cost ? second : first),
+            "Correction must repair the dominance order only when that order is enabled");
+    Label query;
+    initialize(query, PWLFunction::ConstantFunction(0.75, {0.0, 10.0}), b);
+    require(CorrectionInvariantTest::Dominated(mono, &query), "Corrected index must retain a valid dominator");
+    require(CorrectionInvariantTest::Changes(mono) == 1, "Changed merge bucket must be recorded");
+    CorrectionInvariantTest::Refresh(bidirectional);
+    require(CorrectionInvariantTest::Changes(mono) == 0, "Merge refresh must drain changed buckets");
+    require(CorrectionInvariantTest::Pool(bidirectional)[0] == second,
+            "Merge refresh must repair min-cost ordering before early breaks");
+
+    Label null_forward, start, forward, null_backward, end, middle_first, middle_second;
+    null_forward.parent = null_backward.parent = nullptr;
+    start.parent = &null_forward;
+    start.v = 0;
+    start.cut_cost = 0;
+    initialize(forward, PWLFunction::ConstantFunction(0.0, {0.0, 10.0}), {});
+    forward.parent = &start;
+    forward.p = 0.75;
+    forward.min_cost = -0.75;
+    forward.S.set(0).set(1);
+    end.parent = &null_backward;
+    end.v = 4;
+    middle_first.parent = middle_second.parent = &end;
+    middle_first.v = 2;
+    middle_second.v = 3;
+    first->parent = &middle_first;
+    second->parent = &middle_second;
+    first->S = a;
+    second->S = b;
+    require(CorrectionInvariantTest::MergePool(bidirectional, &forward) == 1,
+            "Repaired merge index must retain the negative-cost route");
+    CorrectionInvariantTest::Clean(bidirectional);
+
+    for (bool partial : {true, false}) {
+        mono.partial = partial;
+        auto* retired = new Label;
+        initialize(*retired, PWLFunction::ConstantFunction(1.0, {0.0, 10.0}), a);
+        mono.U[1].Insert(1, {}).push_back(retired);
+        CorrectionInvariantTest::Pool(bidirectional) = {retired};
+        initialize(arriving, PWLFunction::ConstantFunction(0.0, {0.0, 10.0}), a);
+        require(CorrectionInvariantTest::Correct(mono, &arriving) == 1, "Expected full correction");
+        require(CorrectionInvariantTest::Retired(mono) == 1, "Removed parent must retain ownership until cleanup");
+        if (partial) {
+            require(retired->duration.Empty(), "Fully corrected duration must be empty");
+            LazyLabel child{retired, 2, 0.0};
+            require(CorrectionInvariantTest::Extend(mono, child) == nullptr,
+                    "Lazy child must safely reject its live empty parent");
+            CorrectionInvariantTest::Refresh(bidirectional);
+            require(CorrectionInvariantTest::Pool(bidirectional).empty(),
+                    "Merge index must remove empty corrected labels");
+            require(CorrectionInvariantTest::MergePool(bidirectional, retired) == 0,
+                    "Empty forward merge label must be ignored");
+        } else {
+            require(!retired->duration.Empty(), "Full-only correction must preserve its existing valid duration semantics");
+        }
+        CorrectionInvariantTest::Clean(bidirectional);
+        require(CorrectionInvariantTest::Retired(mono) == 0, "Cleanup must release retired owners");
+    }
+
+    // A lazy queue key can predate partial correction of its parent's domain.
+    // Defer the resulting extension and resume it after moving the middle.
+    mono.partial = true;
+    mono.cross = false;
+    mono.lazy_extension = true;
+    mono.limited_extension = false;
+    mono.t_m = 5.0;
+    CorrectionInvariantTest::ConfigureDelayedExtension(mono);
+    auto* existing = new Label;
+    VertexSet old_unreachable = a;
+    old_unreachable.set(0);
+    initialize(*existing, PWLFunction::ConstantFunction(1.0, {8.0, 10.0}), old_unreachable);
+    mono.U[1].Insert(1, {}).push_back(existing);
+    Label parent;
+    initialize(parent, PWLFunction::ConstantFunction(0.0, {8.0, 10.0}), {});
+    parent.v = 0;
+    parent.q = 0;
+    parent.length = 0;
+    parent.S.set(0);
+    LazyLabel lazy{&parent, 1, 0.0};
+    LBQueue queue;
+    queue.push(lazy);
+    MLBExecutionLog log(true);
+    const auto processed = mono.Run(&queue, &log);
+    require(processed.empty() && !queue.empty() && queue.top().makespan == 8.0,
+            "Boundary-crossing candidate must be deferred");
+    require(CorrectionInvariantTest::Retired(mono) == 0 && !existing->duration.Empty(),
+            "A deferred candidate must not retire a stored label");
+    mono.t_m = 10.0;
+    const auto resumed = mono.Run(&queue, &log);
+    require(resumed.size() == 1 && queue.empty(), "Deferred lazy extension must resume safely");
+    require(CorrectionInvariantTest::Retired(mono) == 1 && existing->duration.Empty(),
+            "Accepted resumed label should correct the stored label");
+    CorrectionInvariantTest::Clean(bidirectional);
+}
+
+int main() {
+    try {
+        for (bool arithmetic : {false, true}) {
+            check_default_and_eager_guard(arithmetic);
+            for (bool sorting : {false, true}) check(arithmetic, sorting);
+        }
+        std::cout << "Correction defaults, eager-mode guards, ordering, negative-route retention, ownership and deferred-label checks pass in both arithmetic modes and sorting settings\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/cpp/test_label_correction_pricing.cpp b/tests/cpp/test_label_correction_pricing.cpp
new file mode 100644
index 0000000..075247f
--- /dev/null
+++ b/tests/cpp/test_label_correction_pricing.cpp
@@ -0,0 +1,156 @@
+#include <goc/goc.h>
+#include <nyr/nyr.h>
+
+#include <cmath>
+#include <functional>
+#include <iostream>
+#include <optional>
+#include <stdexcept>
+
+#include "labeling/bidirectional_labeling.h"
+
+using namespace goc;
+using namespace nyr;
+using namespace solver;
+
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+double cost(int u, int v, int seed) {
+    return (u == 0 || v == 5) ? 1.0 : 1.0 + ((u * 7 + v * 3 + seed) % 4) / 4.0;
+}
+
+VRPInstance instance(int seed) {
+    VRPInstance vrp;
+    vrp.D = Digraph(6);
+    vrp.o = 0;
+    vrp.d = 5;
+    vrp.T = 20.0;
+    vrp.horizon = {0.0, vrp.T};
+    vrp.Q = 3.0;
+    vrp.q = {0.0, 1.0, 1.0, 1.0, 1.0, 0.0};
+    vrp.tw = std::vector<goc::Interval>(6, vrp.horizon);
+    vrp.time_steps = {vrp.horizon};
+    vrp.tau = vrp.pretau = vrp.arr = vrp.dep = Matrix<PWLFunction>(6, 6);
+    vrp.LDT = Matrix<double>(6, 6, -goc::INFTY);
+    for (int u = 0; u < 6; ++u) {
+        vrp.tau[u][u] = vrp.pretau[u][u] = PWLFunction::ConstantFunction(0.0, vrp.horizon);
+        vrp.arr[u][u] = vrp.dep[u][u] = PWLFunction::IdentityFunction(vrp.horizon);
+        vrp.LDT[u][u] = vrp.T;
+        for (int v = 0; v < 6; ++v) {
+            if (u == v || u == vrp.d || v == vrp.o) continue;
+            vrp.D.AddArc({u, v});
+            const double travel = cost(u, v, seed);
+            vrp.tau[u][v] = PWLFunction::ConstantFunction(travel, {0.0, vrp.T - travel});
+            vrp.arr[u][v].AddPiece(LinearFunction({0.0, travel}, {vrp.T - travel, vrp.T}));
+            vrp.dep[u][v].AddPiece(LinearFunction({travel, 0.0}, {vrp.T, vrp.T - travel}));
+            vrp.pretau[u][v] = PWLFunction::ConstantFunction(travel, {travel, vrp.T});
+            vrp.LDT[u][v] = vrp.T - travel;
+        }
+    }
+    return vrp;
+}
+
+double route_reduced_cost(const GraphPath& path, const PricingProblem& problem, int seed) {
+    require(path.size() >= 3 && path.front() == 0 && path.back() == 5,
+            "Pricing returned an invalid depot path");
+    unsigned visited = 0;
+    double value = 0.0;
+    int cut_visits = 0;
+    for (std::size_t k = 1; k < path.size(); ++k) {
+        const int u = path[k - 1], v = path[k];
+        require(!(u == 1 && v == 2), "Pricing returned a forbidden arc");
+        value += cost(u, v, seed);
+        if (v == 5) continue;
+        require(v >= 1 && v <= 4 && !(visited & (1U << v)), "Pricing returned a nonelementary path");
+        visited |= 1U << v;
+        value -= problem.P[v];
+        if (v <= 3) ++cut_visits;
+    }
+    require(path.size() - 2 <= 3, "Pricing exceeded capacity");
+    if (cut_visits >= 2) value -= problem.sigma[0];
+    return value;
+}
+
+double oracle(const PricingProblem& problem, int seed) {
+    double best = goc::INFTY;
+    GraphPath path{0};
+    std::function<void(unsigned)> visit = [&](unsigned used) {
+        if (path.size() > 1) {
+            path.push_back(5);
+            best = std::min(best, route_reduced_cost(path, problem, seed));
+            path.pop_back();
+        }
+        if (path.size() == 4) return;
+        for (int v = 1; v <= 4; ++v) {
+            if ((used & (1U << v)) || (path.back() == 1 && v == 2)) continue;
+            path.push_back(v);
+            visit(used | (1U << v));
+            path.pop_back();
+        }
+    };
+    visit(0);
+    return best;
+}
+
+int main() {
+    try {
+        int calls = 0;
+        long long corrected = 0;
+        for (bool arithmetic : {false, true}) {
+            StepExactArithmeticScope scope(arithmetic);
+            for (int seed : {0, 1}) {
+                const auto vrp = instance(seed);
+                for (bool correction : {false, true})
+                    for (bool partial : {false, true})
+                        for (bool closing : {false, true})
+                            for (bool sorting : {false, true}) {
+                                const std::optional<TDNGRoutesParams> ng = std::nullopt;
+                                BidirectionalLabeling labeling(vrp, ng);
+                                labeling.correcting = correction;
+                                labeling.partial = partial;
+                                labeling.closing_state = closing;
+                                labeling.sort_by_cost = sorting;
+                                for (bool negative : {true, false}) {
+                                    PricingProblem problem;
+                                    problem.A = {{1, 2}};
+                                    problem.P = negative ? std::vector<double>{0.0, 2.5, 2.75, 2.25, 3.0, 0.0}
+                                                         : std::vector<double>(6, 0.0);
+                                    SubsetRowCut cut;
+                                    cut.set(1).set(2).set(3);
+                                    problem.S = {cut};
+                                    problem.sigma = {-0.5};
+                                    const double expected = oracle(problem, seed);
+                                    std::vector<goc::Route> routes;
+                                    const auto log = labeling.Run(problem, &routes, LabelingLevel::Exact);
+                                    require(log.status == BLBStatus::Finished, "Tiny exact pricing must complete");
+                                    double observed = goc::INFTY;
+                                    for (const auto& route : routes) {
+                                        const double reduced = route_reduced_cost(route.path, problem, seed);
+                                        double duration = 0.0;
+                                        for (std::size_t k = 1; k < route.path.size(); ++k)
+                                            duration += cost(route.path[k-1], route.path[k], seed);
+                                        require(std::abs(route.duration - duration) < 1e-9,
+                                                "Returned duration differs from independent constant-arc sum");
+                                        require(reduced < -1e-6, "Pricing returned a nonnegative reduced-cost route");
+                                        observed = std::min(observed, reduced);
+                                    }
+                                    if (expected < -1e-6)
+                                        require(std::abs(observed - expected) < 1e-9,
+                                                "Exact pricing lost the exhaustive oracle's best negative route");
+                                    else require(routes.empty(), "Nonnegative pricing oracle requires an empty pool");
+                                    corrected += *log.forward_log->corrected_count + *log.backward_log->corrected_count;
+                                    ++calls;
+                                }
+                            }
+            }
+        }
+        require(corrected > 0, "Synthetic pricing must exercise actual full-label correction");
+        std::cout << calls << " synthetic exact-pricing oracle checks pass, corrected count " << corrected << '\n';
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
